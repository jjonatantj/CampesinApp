@model CampesinApp.ViewModels.RegistroAdminViewModel

@{
    ViewData["Title"] = "Registro de Administrador - CampesinApp";
    Layout = "_LayoutCasosUso";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7 position-relative">
            
            <!-- LOGO SUPERPUESTO -->
            <div class="text-center" style="position: relative; margin-bottom: -75px; z-index: 10;">
                <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo CampesinApp" width="150" height="150" class="rounded-circle shadow-lg border border-3 border-success bg-white" style="object-fit: cover;" />
            </div>

            <!-- CAJA PRINCIPAL -->
            <div class="card main-container border-0 shadow-lg p-4 p-md-5 pt-5">
                <div class="text-center mb-4 mt-3">
                    <h2 class="brand-title mb-1">Registro de Administrador</h2>
                    <p class="text-muted" style="font-weight: 500;">Ingrese los datos para registrar un nuevo usuario administrador</p>
                </div>

                <form asp-action="Index" method="post" id="formRegistroAdmin">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- DOCUMENTO Y NOMBRES -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cedula" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Cedula" class="form-control rounded-pill px-3 py-2" placeholder="Número de cédula" />
                            <span asp-validation-for="Cedula" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Nombres" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Nombres" class="form-control rounded-pill px-3 py-2" placeholder="Nombres" />
                            <span asp-validation-for="Nombres" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- APELLIDOS Y TELÉFONO -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Apellidos" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Apellidos" class="form-control rounded-pill px-3 py-2" placeholder="Apellidos" />
                            <span asp-validation-for="Apellidos" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefono" class="form-label fw-bold text-dark"></label>
                            <input asp-for="Telefono" class="form-control rounded-pill px-3 py-2" placeholder="3156337952" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- CORREO ELECTRÓNICO -->
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-bold text-dark"></label>
                        <input asp-for="Correo" class="form-control rounded-pill px-3 py-2" placeholder="admin@campesinapp.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <!-- CONTRASEÑA Y CONFIRMACIÓN -->
                    <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Contrasena" class="form-label fw-bold text-dark"></label>
                                <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                                    <input asp-for="Contrasena" type="password" id="txtPasswordReg" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Ingrese Contraseña" />
                                    <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtPasswordReg', 'iconRegPass')">
                                        <svg id="iconRegPass" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                        </svg>
                                    </button>
                                </div>
                                <span asp-validation-for="Contrasena" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="ConfirmarContrasena" class="form-label fw-bold text-dark"></label>
                                <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                                    <input asp-for="ConfirmarContrasena" type="password" id="txtConfirmarReg" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Confirme su contraseña" />
                                    <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtConfirmarReg', 'iconConfirmReg')">
                                        <svg id="iconConfirmReg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                        </svg>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                            </div>
                    </div>

                    <!-- BOTONES ACCIÓN -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2" onclick="abrirModalCancelar()">Cancelar</button>
                        <button type="submit" class="btn btn-nav-register px-4 py-2" style="font-size: 1rem;">Guardar Administrador</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CONFIRMACIÓN DE CANCELACIÓN -->
<div class="modal fade" id="modalCancelarAdmin" tabindex="-1" aria-labelledby="modalCancelarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4 rounded-4 shadow border-0">
            <div class="modal-body">
                <div class="mb-3">
                    <i class="bi bi-question-circle text-warning" style="font-size: 3.5rem;"></i>
                </div>
                <h4 class="fw-bold mb-3" style="color: #2e7d32;">¿Deseas cancelar el registro?</h4>
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold" data-bs-dismiss="modal">NO</button>
                    <a href="@Url.Action("Index", "Perfil")" class="btn btn-success rounded-pill px-4 py-2 fw-semibold">SÍ</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE ÉXITO REGISTRO -->
<div class="modal fade" id="modalExitoAdmin" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalExitoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4 rounded-4 shadow border-0">
            <div class="modal-body">
                <div class="mb-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
                </div>
                <h4 class="fw-bold mb-3" style="color: #1b5e20;">¡Éxito!</h4>
                <p class="fs-5 text-dark mb-4">Usuario administrador creado con éxito</p>
                <button type="button" class="btn btn-success rounded-pill px-5 py-2 fw-semibold" onclick="redirigirPerfil('@Url.Action("Index", "Perfil")')">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/MostrarContraseña.js" asp-append-version="true"></script>
    <script src="~/js/RegistroAdmin.js" asp-append-version="true"></script>
    
    @if (TempData["MensajeExito"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var modalExitoElement = document.getElementById('modalExitoAdmin');
                if (modalExitoElement) {
                    var modalExito = new bootstrap.Modal(modalExitoElement);
                    modalExito.show();
                }
            });
        </script>
    }
}