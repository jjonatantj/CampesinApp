@model CampesinApp.ViewModels.RegistroUsuarioViewModel

@{
    ViewData["Title"] = "Registro de Usuario - CampesinApp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7 position-relative">

            <!-- LOGO SUPERPUESTO -->
            <div class="text-center" style="position: relative; margin-bottom: -75px; z-index: 10;">
                <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo CampesinApp" width="150" height="150" class="rounded-circle shadow-lg border border-3 border-success bg-white" style="object-fit: cover;" />
            </div>

            <!-- CAJA PRINCIPAL -->
            <div class="card main-container border-0 shadow-lg p-4 p-md-5 pt-5">
                <div class="text-center mb-4 mt-3">
                    <h2 class="brand-title mb-1">
                        @if (Model.Paso == 1)
                        {
                            <span>Registro de Usuario</span>
                        }
                        else if (Model.Paso == 2)
                        {
                            <span>Método de Verificación</span>
                        }
                        else
                        {
                            <span>Verificación de Código</span>
                        }
                    </h2>
                    <p class="text-muted" style="font-weight: 500;">
                        @if (Model.Paso == 1)
                        {
                            <span>Diligencie sus datos para unirse a CampesinApp</span>
                        }
                        else if (Model.Paso == 2)
                        {
                            <span>Seleccione el medio para recibir el código de verificación</span>
                        }
                        else
                        {
                            <span>Ingrese el código de 6 dígitos recibido</span>
                        }
                    </p>
                </div>

                @if (TempData["ErrorRegistro"] != null)
                {
                    <div class="alert alert-danger rounded-pill text-center py-2 mb-3 small fw-semibold">
                        @TempData["ErrorRegistro"]
                    </div>
                }

                @if (TempData["MensajeReenvio"] != null)
                {
                    <div class="alert alert-success rounded-pill text-center py-2 mb-3 small fw-semibold">
                        @TempData["MensajeReenvio"]
                    </div>
                }

                <form asp-action="Index" method="post" enctype="multipart/form-data" id="formRegistro">
                    <input type="hidden" asp-for="Paso" />

                    @if (Model.Paso == 2)
                    {
                        <input type="hidden" asp-for="CorreoEnmascarado" />
                        <input type="hidden" asp-for="TelefonoEnmascarado" />
                    }
                    else if (Model.Paso == 3)
                    {
                        <input type="hidden" asp-for="MetodoSeleccionado" />
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- PASO 1 -->
                    @if (Model.Paso == 1)
                    {
                        <div class="text-center mb-4">
                            <label class="form-label fw-bold text-dark d-block mb-2">Foto de Perfil <span class="text-danger">*</span></label>
                            <div class="d-flex flex-column align-items-center">
                                <div class="rounded-circle shadow-sm border border-2 border-secondary overflow-hidden bg-white d-flex align-items-center justify-content-center mb-2" style="width: 110px; height: 110px;">
                                    <img id="previewFoto" src="#" alt="Vista previa" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                                    <span id="placeholderText" class="text-muted small text-center px-1" style="font-size: 0.8rem;">Sin foto</span>
                                </div>
                                <label for="fileInputFoto" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-bold shadow-sm" style="cursor: pointer;">
                                    Agregar foto
                                </label>
                                <input asp-for="FotoPerfil" type="file" id="fileInputFoto" class="d-none" accept="image/*" onchange="mostrarVistaPrevia(event)" />
                                <span asp-validation-for="FotoPerfil" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombres" class="form-label fw-bold text-dark"></label>
                                <input asp-for="Nombres" class="form-control rounded-pill px-3 py-2" placeholder="Nombres" />
                                <span asp-validation-for="Nombres" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellidos" class="form-label fw-bold text-dark"></label>
                                <input asp-for="Apellidos" class="form-control rounded-pill px-3 py-2" placeholder="Apellidos" />
                                <span asp-validation-for="Apellidos" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cedula" class="form-label fw-bold text-dark"></label>
                                <input asp-for="Cedula" class="form-control rounded-pill px-3 py-2" placeholder="Número de cédula" />
                                <span asp-validation-for="Cedula" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdRol" class="form-label fw-bold text-dark"></label>
                                <select asp-for="IdRol" asp-items="Model.ListaRoles" class="form-select rounded-pill px-3 py-2">
                                    <option value="">Seleccione su rol...</option>
                                </select>
                                <span asp-validation-for="IdRol" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-bold text-dark"></label>
                                <input asp-for="Correo" class="form-control rounded-pill px-3 py-2" placeholder="correo@ejemplo.com" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="form-label fw-bold text-dark"></label>
                                <input asp-for="Telefono" class="form-control rounded-pill px-3 py-2" placeholder="3156337952" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="IdDepartamento" class="form-label fw-bold text-dark"></label>
                                <select id="ddlDepartamento" asp-for="IdDepartamento" asp-items="Model.ListaDepartamentos" class="form-select rounded-pill px-3 py-2" onchange="cargarMunicipios()">
                                    <option value="">Seleccione departamento...</option>
                                </select>
                                <span asp-validation-for="IdDepartamento" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IdMunicipio" class="form-label fw-bold text-dark"></label>
                                <select id="ddlMunicipio" asp-for="IdMunicipio" asp-items="Model.ListaMunicipios" class="form-select rounded-pill px-3 py-2">
                                    <option value="">Seleccione municipio...</option>
                                </select>
                                <span asp-validation-for="IdMunicipio" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Contrasena" class="form-label fw-bold text-dark"></label>
                                <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                                    <input asp-for="Contrasena" type="password" id="txtPasswordReg" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Ingrese Contraseña" />
                                    <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtPasswordReg', 'iconRegPass')">
                                        <svg id="iconRegPass" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                        </svg>
                                    </button>
                                </div>
                                <span asp-validation-for="Contrasena" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="ConfirmarContrasena" class="form-label fw-bold text-dark"></label>
                                <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                                    <input asp-for="ConfirmarContrasena" type="password" id="txtConfirmarReg" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Confirme su contraseña" />
                                    <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtConfirmarReg', 'iconConfirmReg')">
                                        <svg id="iconConfirmReg" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                            <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                        </svg>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end align-items-center gap-2 mt-4">
                            <a asp-controller="PaginaBienvenida" asp-action="Bienvenida" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-flex justify-content-center align-items-center">Volver</a>
                            <button type="submit" class="btn btn-nav-register px-5 py-2 d-flex justify-content-center align-items-center" style="font-size: 1rem;">Continuar</button>
                        </div>
                    }

                    <!-- PASO 2 -->
                    @if (Model.Paso == 2)
                    {
                        <div class="mb-4 text-start">
                            <div class="form-check p-3 border rounded-pill mb-3 bg-white shadow-sm">
                                <input class="form-check-input ms-1" type="radio" asp-for="MetodoSeleccionado" value="correo" id="metodoCorreo" checked />
                                <label class="form-check-label fw-bold text-dark ms-2" for="metodoCorreo">
                                    <i class="bi bi-envelope-fill text-success me-2"></i> Correo: <span class="text-muted fw-normal">@Model.CorreoEnmascarado</span>
                                </label>
                            </div>
                            <div class="form-check p-3 border rounded-pill bg-white shadow-sm">
                                <input class="form-check-input ms-1" type="radio" asp-for="MetodoSeleccionado" value="telefono" id="metodoTelefono" />
                                <label class="form-check-label fw-bold text-dark ms-2" for="metodoTelefono">
                                    <i class="bi bi-whatsapp text-success me-2"></i> WhatsApp (Simulado): <span class="text-muted fw-normal">@Model.TelefonoEnmascarado</span>
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-nav-register py-2 w-100 d-flex justify-content-center align-items-center" style="font-size: 1rem;">Enviar Código</button>
                        </div>
                        <div class="text-center mt-3 small">
                            <a asp-action="VolverARegistro" class="text-success fw-bold text-decoration-none">Volver a registro</a>
                        </div>
                    }

                    <!-- PASO 3 -->
                    @if (Model.Paso == 3)
                    {
                        @if (Model.MetodoSeleccionado == "telefono")
                        {
                            <div class="alert alert-success border-2 rounded-3 p-3 my-3 shadow-sm text-center" style="background-color: #f0fdf4;">
                                <span class="d-block small text-success fw-bold mb-1"><i class="bi bi-whatsapp"></i> CÓDIGO WHATSAPP SIMULADO:</span>
                                <span class="fs-3 fw-bold text-dark tracking-widest">@ViewBag.CodigoWhatsappSimulado</span>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-2">Hemos enviado un código de verificación de 6 dígitos a su correo electrónico.</p>
                        }

                        <div id="temporizadorContainer" class="mt-2 mb-3 text-center">
                            <span class="fw-bold" style="color: #1d4ed8; font-size: 0.90rem;">
                                El código expira en <span id="tiempoRestante">05:00</span>
                            </span>
                        </div>

                        <div class="mb-3 text-start">
                            <label asp-for="CodigoVerificacion" class="form-label fw-bold text-dark small">Código de Verificación</label>
                            <input asp-for="CodigoVerificacion" id="txtCodigoVerificacion" class="form-control text-center rounded-pill py-2" placeholder="000000" maxlength="6" autocomplete="off" />
                            <span asp-validation-for="CodigoVerificacion" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" id="btnVerificar" class="btn btn-nav-register py-2 w-100 d-flex justify-content-center align-items-center" style="font-size: 1rem;">Finalizar Registro</button>
                        </div>

                        <!-- REENVÍO CON LÍMITE DE 3 VECES Y CONTROL DINÁMICO DE RESTANTES -->
                        <div class="text-center mt-3 small">
                            <span class="text-muted">¿No recibiste el código?</span>
                            <a href="@Url.Action("ReenviarCodigoRegistro")" id="btnReenviar" class="text-success fw-bold text-decoration-none ms-1">
                                Reenviar código (<span id="contadorReenvios">@(ViewBag.ReenviosRestantes ?? 3)</span> restantes)
                            </a>
                        </div>
                        <div id="cooldownText" class="text-center text-muted small mt-1" style="display: none;">
                            Podrá volver a solicitar el código en <span id="tiempoCooldown">60</span>s
                        </div>

                        <div class="d-flex justify-content-between small mt-3 pt-2 border-top">
                            <a asp-action="VolverARegistro" class="text-muted text-decoration-none">Volver a registro</a>
                            <a asp-action="CambiarMetodo" class="text-success text-decoration-none fw-bold">Cambiar método</a>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/MostrarContraseña.js" asp-append-version="true"></script>
    <script src="~/js/FotoPerfil.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const pasoActual = @Model.Paso;
        const reenviosRestantes = @(ViewBag.ReenviosRestantes ?? 3);

        @if (ViewBag.RegistroExitoso != null && (bool)ViewBag.RegistroExitoso)
            {
                <text>
                    document.addEventListener("DOMContentLoaded", function () {
                        let timerInterval;
                        Swal.fire({
                            icon: 'success',
                            title: '¡Registro Exitoso!',
                            html: 'Ya puedes iniciar sesión. Serás redirigido en <b>5</b> segundos.',
                            timer: 5000,
                            timerProgressBar: true,
                            showConfirmButton: true,
                            confirmButtonText: 'OK',
                            confirmButtonColor: '#198754',
                            background: '#f8f9fa',
                            customClass: { popup: 'rounded-4 shadow-lg' },
                            didOpen: () => {
                                const b = Swal.getHtmlContainer().querySelector('b');
                                timerInterval = setInterval(() => {
                                    b.textContent = Math.ceil(Swal.getTimerLeft() / 1000);
                                }, 1000);
                            },
                            willClose: () => {
                                clearInterval(timerInterval);
                            }
                        }).then((result) => {
                            window.location.href = '@Url.Action("Login", "InicioSesion")';
                        });
                    });
            </text>
        }

                if (pasoActual === 3) {
            let tiempoRestanteSegundos = 300;
            const elementoReloj = document.getElementById('tiempoRestante');

            const cuentaRegresiva = setInterval(() => {
                let minutos = Math.floor(tiempoRestanteSegundos / 60);
                let segundos = tiempoRestanteSegundos % 60;

                minutos = minutos < 10 ? '0' + minutos : minutos;
                segundos = segundos < 10 ? '0' + segundos : segundos;

                if (elementoReloj) {
                    elementoReloj.textContent = minutos + ':' + segundos;
                }

                if (tiempoRestanteSegundos <= 0) {
                    clearInterval(cuentaRegresiva);
                    if (elementoReloj) {
                        elementoReloj.textContent = "00:00 (Caducado)";
                        elementoReloj.classList.add("text-danger");
                    }
                } else {
                    tiempoRestanteSegundos--;
                }
            }, 1000);

            const btnReenviar = document.getElementById('btnReenviar');
            const cooldownText = document.getElementById('cooldownText');
            const tiempoCooldownSpan = document.getElementById('tiempoCooldown');

            if (reenviosRestantes <= 0) {
                if (btnReenviar) {
                    btnReenviar.style.pointerEvents = "none";
                    btnReenviar.classList.add("text-muted", "disabled");
                    btnReenviar.innerHTML = "Límite de reenvíos alcanzado (0 restantes)";
                }
                if (cooldownText) cooldownText.style.display = "none";
            } else {
                let cooldownSegundos = 60;
                btnReenviar.style.pointerEvents = "none";
                btnReenviar.classList.add("text-muted");
                cooldownText.style.display = "block";

                const timerCooldown = setInterval(() => {
                    cooldownSegundos--;
                    if (tiempoCooldownSpan) tiempoCooldownSpan.textContent = cooldownSegundos;
                    if (cooldownSegundos <= 0) {
                        clearInterval(timerCooldown);
                        btnReenviar.style.pointerEvents = "auto";
                        btnReenviar.classList.remove("text-muted");
                        cooldownText.style.display = "none";
                    }
                }, 1000);
            }
        }

        function cargarMunicipios() {
            var depId = $("#ddlDepartamento").val();
            var $ddlMuni = $("#ddlMunicipio");
            $ddlMuni.empty().append('<option value="">Cargando municipios...</option>');

            if (depId) {
                $.getJSON('/RegistroUsuario/ObtenerMunicipiosPorDepartamento?idDepartamento=' + depId, function (data) {
                    $ddlMuni.empty().append('<option value="">Seleccione municipio...</option>');
                    $.each(data, function (i, item) {
                        $ddlMuni.append($('<option>', { value: item.id, text: item.nombre }));
                    });
                });
            } else {
                $ddlMuni.empty().append('<option value="">Seleccione municipio...</option>');
            }
        }
    </script>
}