@model CampesinApp.ViewModels.VerificacionCodigoViewModel

@{
    ViewData["Title"] = "Verificación de Usuario - CampesinApp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 position-relative">
            
            <!-- LOGO -->
            <div class="text-center" style="position: relative; margin-bottom: -75px; z-index: 10;">
                <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo CampesinApp" width="150" height="150" class="rounded-circle shadow-lg border border-3 border-success bg-white" style="object-fit: cover;" />
            </div>

            <div class="card main-container border-0 shadow-lg p-4 pt-5 text-center">
                
                <div class="mb-3 mt-3">
                    <h3 class="brand-title mt-2">Verificación de Datos</h3>
                    <p class="text-muted small mt-2">
                        Hemos enviado un código de verificación de 6 dígitos a tu correo (<strong class="text-dark">@Model.Correo</strong>) y a tu teléfono (<strong class="text-dark">@Model.Telefono</strong>).
                    </p>
                    
                    <!-- TEMPORIZADOR REGRESIVO EN AZUL PROFESIONAL -->
                    <div id="temporizadorContainer" class="mt-2 mb-2">
                        <span class="fw-bold" style="color: #1d4ed8; font-size: 0.95rem;">
                            El código expira en <span id="tiempoRestante">04:59</span>
                        </span>
                    </div>

                    <!-- MUESTRA DEL CÓDIGO SMS/TELÉFONO EN PANTALLA -->
                    @if (ViewBag.CodigoSmsPrueba != null)
                    {
                        <div class="alert alert-info text-center mt-3 mb-2 py-2" style="font-size: 0.85rem; border-radius: 12px;">
                            <strong>📱 Código de Teléfono (Prueba):</strong> 
                            <span class="badge bg-primary fs-6 ms-1" style="letter-spacing: 2px;">@ViewBag.CodigoSmsPrueba</span>
                        </div>
                    }
                </div>

                <form asp-action="Verificacion" method="post" id="formVerificacion">
                    <input type="hidden" asp-for="Correo" />
                    <input type="hidden" asp-for="Telefono" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3 text-start">
                        <label asp-for="CodigoCorreo" class="form-label fw-bold text-dark small"></label>
                        <input asp-for="CodigoCorreo" id="txtCodigoCorreo" class="form-control text-center rounded-pill py-2" placeholder="Ingrese los 6 dígitos" maxlength="6" autocomplete="off" />
                        <span asp-validation-for="CodigoCorreo" class="text-danger small"></span>
                        <span id="errorCorreo" class="text-danger small d-block"></span>
                    </div>

                    <div class="mb-4 text-start">
                        <label asp-for="CodigoTelefono" class="form-label fw-bold text-dark small"></label>
                        <input asp-for="CodigoTelefono" id="txtCodigoTelefono" class="form-control text-center rounded-pill py-2" placeholder="Ingrese los 6 dígitos" maxlength="6" autocomplete="off" />
                        <span asp-validation-for="CodigoTelefono" class="text-danger small"></span>
                        <span id="errorTelefono" class="text-danger small d-block"></span>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <!-- BOTÓN -->
                        <button type="button" id="btnFinalizar" class="btn btn-nav-register py-2 justify-content-center" style="font-size: 1rem;">
                            Finalizar Registro
                        </button>
                    </div>
                </form>

                <div class="d-flex justify-content-between align-content-center mt-3 small">
                    <a asp-action="Index" class="text-success fw-bold text-decoration-none">Volver a registro</a>
                    <a href="#" class="text-muted text-decoration-none">Reenviar códigos</a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/VerificacionCodigo.js" asp-append-version="true"></script>
}