@model CampesinApp.ViewModels.PublicarDemandaViewModel

@{
    ViewData["Title"] = "Publicar Demanda - CampesinApp";
    Layout = "_LayoutCasosUso";
    string googleMapsApiKey = ViewBag.GoogleMapsApiKey ?? string.Empty;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 position-relative">

            <!-- LOGO FLOTANTE OFICIAL -->
            <div class="text-center" style="position: relative; margin-bottom: -75px; z-index: 10;">
                <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo CampesinApp" width="150" height="150" class="rounded-circle shadow-lg border border-3 border-success bg-white" style="object-fit: cover;" />
            </div>

            <div class="card main-container border-0 shadow-lg p-4 p-md-5 pt-5 bg-white rounded-4">

                <div class="text-center mb-4 mt-3">
                    <h2 class="fw-bold text-dark mb-1">Publicar Nueva Demanda Mayorista</h2>
                    <p class="text-muted small fw-semibold">Seleccione su punto de acopio autorizado, valide el precio estadístico y proceda al pago seguro.</p>
                </div>

                <!-- TARJETA INFORMATIVA DEL MODELO ESTADÍSTICO -->
                <div id="cardPrecioSugerido" class="alert border-0 shadow-sm rounded-4 mb-4 d-none p-4 text-white" style="background: linear-gradient(135deg, #2e7d32 0%, #43a047 100%);">
                    <div>
                        <h5 class="alert-heading fw-bold mb-1 text-white"><i class="bi bi-graph-up-arrow me-2"></i>Precio Sugerido del Modelo Estadístico</h5>
                        <p class="mb-1 fs-5 fw-semibold" id="txtPrecioSugerido">Cargando...</p>
                        <p class="mb-0 small text-light opacity-90" id="txtRangoPermitido">Rango permitido mayorista (±10%): -</p>
                    </div>
                </div>

                <form id="formPublicarDemanda" onsubmit="enviarDemandaAjax(event)">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-semibold"></div>

                    <div class="row">
                        <!-- COLUMNA IZQUIERDA: FORMULARIO -->
                        <div class="col-lg-6">
                            <!-- PRODUCTO Y VARIEDAD -->
                            <div class="mb-3">
                                <label asp-for="IdTipoProducto" class="form-label fw-bold text-dark small"></label>
                                <select id="ddlTipoProducto" asp-for="IdTipoProducto" asp-items="Model.ListaTiposProducto" class="form-select rounded-pill px-3 py-2" onchange="cargarVariedades()">
                                    <option value="">Seleccione tipo de producto...</option>
                                </select>
                                <span asp-validation-for="IdTipoProducto" class="text-danger small fw-semibold"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="IdVariedad" class="form-label fw-bold text-dark small"></label>
                                <select id="ddlVariedad" asp-for="IdVariedad" asp-items="Model.ListaVariedades" class="form-select rounded-pill px-3 py-2" onchange="consultarPrecioModelo()">
                                    <option value="">Seleccione variedad...</option>
                                </select>
                                <span asp-validation-for="IdVariedad" class="text-danger small fw-semibold"></span>
                            </div>

                            <!-- CANTIDAD Y PRECIO -->
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Cantidad" class="form-label fw-bold text-dark small"></label>
                                    <input asp-for="Cantidad" id="txtCantidad" type="number" step="1" class="form-control rounded-pill px-3 py-2" placeholder="Ej: 500" oninput="calcularToneladas()" onkeypress="return soloNumeros(event)" />
                                    <small class="text-success fw-bold d-block mt-1 ms-2" id="lblConversionTon">Equivalente: 0.00 Toneladas</small>
                                    <span asp-validation-for="Cantidad" class="text-danger small fw-semibold"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="PrecioEstimado" class="form-label fw-bold text-dark small"></label>
                                    <!-- El input con su id para control de estilos -->
                                    <input id="txtPrecioEstimado" asp-for="PrecioEstimado" type="number" step="1" class="form-control rounded-pill px-3 py-2" placeholder="Ej: 3500" onkeypress="return soloNumeros(event)" />
                                    <!-- Contenedor dedicado exclusivamente al texto de error en rojo -->
                                    <span id="errorTextoPrecio" class="text-danger small fw-semibold d-block mt-1"></span>
                                    <span asp-validation-for="PrecioEstimado" class="text-danger small fw-semibold" style="display:none;"></span>
                                </div>
                            </div>

                            <!-- FECHAS Y HORARIOS -->
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FechaEntrega" class="form-label fw-bold text-dark small"></label>
                                    <input asp-for="FechaEntrega" type="date" id="txtFechaEntrega" class="form-control rounded-pill px-3 py-2 mb-1" />
                                    <small class="text-muted d-block ms-2" style="font-size: 0.75rem;">Mínimo 4 días a partir de hoy.</small>
                                    <span asp-validation-for="FechaEntrega" class="text-danger small fw-semibold"></span>

                                    <label asp-for="HoraEntrega" class="form-label fw-bold text-dark small mt-2"></label>
                                    <input asp-for="HoraEntrega" type="time" class="form-control rounded-pill px-3 py-2" value="08:00" />
                                    <span asp-validation-for="HoraEntrega" class="text-danger small fw-semibold"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <!-- Campos actualizados con el nombre requerido de 2 días y textos correctos -->
                                    <label class="form-label fw-bold text-dark small">Fecha disponible en el aplicativo</label>
                                    <input asp-for="LimTiemDeman" type="date" id="txtFechaLimite" class="form-control rounded-pill px-3 py-2 mb-1 bg-light text-muted" readonly />
                                    <small class="text-success fw-semibold d-block ms-2" style="font-size: 0.75rem;">Disponible por 2 días hasta medianoche.</small>
                                    <span asp-validation-for="LimTiemDeman" class="text-danger small fw-semibold"></span>

                                    <label class="form-label fw-bold text-dark small mt-2">Hora disponible en el aplicativo</label>
                                    <input asp-for="HoraLimite" type="time" class="form-control rounded-pill px-3 py-2 bg-light text-muted" value="23:59" readonly />
                                    <span asp-validation-for="HoraLimite" class="text-danger small fw-semibold"></span>
                                </div>
                            </div>

                            <!-- PUNTO DE ACOPIO AUTORIZADO -->
                            <div class="mb-3">
                                <label asp-for="IdPuntoAcopio" class="form-label fw-bold text-dark small"></label>
                                <select id="ddlPuntoAcopio" asp-for="IdPuntoAcopio" asp-items="Model.ListaPuntosAcopio" class="form-select rounded-pill px-3 py-2" onchange="actualizarUbicacionMapa()">
                                    <option value="">Seleccione su punto de acopio...</option>
                                </select>
                                <span asp-validation-for="IdPuntoAcopio" class="text-danger small fw-semibold"></span>

                                @if (!Model.TienePuntosAcopio)
                                {
                                    <div class="mt-2 text-danger small fw-semibold">
                                        <i class="bi bi-exclamation-circle me-1"></i> No tienes registrado punto de acopio.
                                        <a href="@Url.Action("Index", "PuntoAcopio")" class="text-success fw-bold text-decoration-underline">Registra uno aquí</a>.
                                    </div>
                                }
                            </div>

                            <!-- DESCRIPCIÓN -->
                            <div class="mb-3">
                                <label asp-for="Descripcion" class="form-label fw-bold text-dark small"></label>
                                <textarea asp-for="Descripcion" class="form-control rounded-4 px-3 py-2" rows="2" placeholder="Detalle especificaciones de calidad..."></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger small fw-semibold"></span>
                            </div>
                        </div>

                        <!-- COLUMNA DERECHA: MAPA DE GOOGLE MAPS (SATELITAL) -->
                        <div class="col-lg-6 d-flex flex-column">
                            <label class="form-label fw-bold text-dark small"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Ubicación Geográfica del Punto de Acopio (Vista Satelital)</label>
                            <div class="flex-grow-1 border rounded-4 overflow-hidden shadow-sm bg-light mb-3" style="min-height: 380px; position: relative;">
                                <div id="map" style="width: 100%; height: 100%; min-height: 380px;"></div>
                            </div>
                            <div id="infoPuntoAcopio" class="p-3 bg-light border rounded-4 text-muted small mb-3">
                                <i class="bi bi-info-circle me-1"></i> Seleccione un punto de acopio para visualizar su ubicación exacta en el mapa satelital.
                            </div>
                        </div>
                    </div>

                    <!-- BOTONES DE ACCIÓN -->
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <!-- Botón cancelar redirige a la acción del controlador que limpia la sesión y devuelve al perfil -->
                        <a href="@Url.Action("Cancelar", "PublicarDemanda")" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancelar</a>
                        <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold shadow-sm" style="background-color: #2e7d32; border-color: #2e7d32;">
                            Publicar Demanda y Pagar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25" integrity="sha384-nLoOnA/BDh8A/jxqtckg4DumuCGOBYUnNJLZdQz/zfYNp3wcjGSoWTAzgko06G/2" crossorigin="anonymous"></script>

    <!-- Script oficial de Google Maps API -->
    <script src="https://maps.googleapis.com/maps/api/js?key=@googleMapsApiKey&callback=initMap" async defer></script>

    <script>
        let map;
        let marker;
        let precioMinPermitido = 0;
        let precioMaxPermitido = 0;

        function initMap() {
            const centroColombia = { lat: 4.7110, lng: -74.0721 };
            map = new google.maps.Map(document.getElementById("map"), {
                zoom: 12,
                center: centroColombia,
                mapTypeId: "satellite",
                mapTypeControl: true,
                streetViewControl: false
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            configurarFechasAutomaticas();
        });

        function configurarFechasAutomaticas() {
            const hoy = new Date();

            const fechaLimite = new Date(hoy);
            fechaLimite.setDate(hoy.getDate() + 2);
            const strFechaLimite = fechaLimite.toISOString().split('T')[0];

            const inputFechaLimite = document.getElementById('txtFechaLimite');
            if (inputFechaLimite) {
                inputFechaLimite.value = strFechaLimite;
            }

            const minEntrega = new Date(hoy);
            minEntrega.setDate(hoy.getDate() + 4);
            const strMinEntrega = minEntrega.toISOString().split('T')[0];

            const inputFechaEntrega = document.getElementById('txtFechaEntrega');
            if (inputFechaEntrega) {
                inputFechaEntrega.min = strMinEntrega;
                inputFechaEntrega.value = strMinEntrega;
            }
        }

        function actualizarUbicacionMapa() {
            var idPunto = $("#ddlPuntoAcopio").val();
            if (!idPunto) {
                if (marker) marker.setMap(null);
                $("#infoPuntoAcopio").html('<i class="bi bi-info-circle me-1"></i> Seleccione un punto de acopio para visualizar su ubicación exacta en el mapa satelital.');
                return;
            }

            $.getJSON('@Url.Action("ObtenerCoordenadasPuntoAcopio", "PublicarDemanda")', { idPuntoAcopio: idPunto }, function (data) {
                if (data && data.exito) {
                    const latLng = { lat: Number.parseFloat(data.lat), lng: Number.parseFloat(data.lng) };

                    if (marker) {
                        marker.setPosition(latLng);
                    } else {
                        marker = new google.maps.Marker({
                            position: latLng,
                            map: map,
                            title: data.nombre,
                            animation: google.maps.Animation.DROP
                        });
                    }
                    map.setCenter(latLng);
                    map.setZoom(17);

                    $("#infoPuntoAcopio").html(`<strong>Punto:</strong> ${data.nombre}<br><strong>Dirección:</strong> ${data.direccion}`);
                }
            });
        }

        function soloNumeros(e) {
            var charCode = (e.which) ? e.which : e.keyCode;
            if (charCode > 31 && (charCode < 48 || charCode > 57)) return false;
            return true;
        }
        function calcularToneladas() {
            let kilos = Number.parseFloat($("#txtCantidad").val());
            if (!isNaN(kilos) && kilos > 0) {
                let toneladas = kilos / 1000;
                let formatoToneladas = Number.isInteger(toneladas) ? toneladas : toneladas.toFixed(2);
                $("#lblConversionTon").text(`Equivalente: ${formatoToneladas} Toneladas`);
            } else {
                $("#lblConversionTon").text("Equivalente: 0 Toneladas");
            }
        }

        function cargarVariedades() {
            var idTipo = $("#ddlTipoProducto").val();
            var $ddlVariedad = $("#ddlVariedad");
            $ddlVariedad.empty().append('<option value="">Cargando variedades...</option>');
            $("#cardPrecioSugerido").addClass("d-none");

            if (idTipo) {
                $.getJSON('@Url.Action("ObtenerVariedadesPorTipo", "PublicarDemanda")', { idTipoProducto: idTipo }, function (data) {
                    $ddlVariedad.empty().append('<option value="">Seleccione variedad...</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            $ddlVariedad.append($('<option>', { value: item.id, text: item.nombre }));
                        });
                    } else {
                        $ddlVariedad.append('<option value="" disabled>(No hay variedades registradas)</option>');
                    }
                });
            } else {
                $ddlVariedad.empty().append('<option value="">Seleccione variedad...</option>');
            }
        }

        function consultarPrecioModelo() {
            var idTipo = $("#ddlTipoProducto").val();
            var idVariedad = $("#ddlVariedad").val();

            if (idTipo && idVariedad) {
                $.getJSON('@Url.Action("ObtenerPrecioEstimado", "PublicarDemanda")', { idTipoProducto: idTipo, idVariedad: idVariedad }, function (data) {
                    if (data && data.exito) {
                        precioMinPermitido = data.min;
                        precioMaxPermitido = data.max;

                        $("#txtPrecioSugerido").text(`Precio oficial: $${data.precio.toLocaleString()} COP / kg`);
                        $("#txtRangoPermitido").text(`Rango permitido mayorista (±10%): $${data.min.toLocaleString()} - $${data.max.toLocaleString()} COP`);
                        $("#cardPrecioSugerido").removeClass("d-none");
                    } else {
                        $("#cardPrecioSugerido").addClass("d-none");
                    }
                });
            } else {
                $("#cardPrecioSugerido").addClass("d-none");
            }
        }

        function enviarDemandaAjax(event) {
            event.preventDefault();

            var precioIngresado = Number.parseFloat($("#txtPrecioEstimado").val());
            var cantidadIngresada = Number.parseFloat($("#txtCantidad").val());

            // Limpiar errores visuales previos en el input de precio
            $("#errorTextoPrecio").text("");
            $("#txtPrecioEstimado").removeClass("is-invalid");

            if (isNaN(cantidadIngresada) || cantidadIngresada < 20) {
                Swal.fire('Cantidad insuficiente', 'Para compradores mayoristas, la cantidad mínima requerida es de 20 kg.', 'error');
                return;
            }

            if (isNaN(precioIngresado) || precioIngresado < 100) {
                // Marcar en rojo el borde con icono y mostrar el texto abajo
                $("#txtPrecioEstimado").addClass("is-invalid");
                $("#errorTextoPrecio").text("El precio propuesto debe ser mayor o igual a 100 COP.");

                Swal.fire('Precio inválido', 'El precio propuesto debe ser mayor o igual a 100 COP.', 'error');
                return;
            }

            // Validación estricta del margen del 10% del modelo estadístico
            if (precioMinPermitido > 0 && precioMaxPermitido > 0) {
                if (precioIngresado < precioMinPermitido || precioIngresado > precioMaxPermitido) {
                    var mensajeError = `Fuera del margen permitido (±10%): $${precioMinPermitido.toLocaleString()} - $${precioMaxPermitido.toLocaleString()} COP.`;

                    // 1. Enmarca el campo con borde rojo e icono de advertencia
                    $("#txtPrecioEstimado").addClass("is-invalid");
                    // 2. Muestra el texto detallado en rojo debajo del campo
                    $("#errorTextoPrecio").text(mensajeError);

                    // 3. Muestra la alerta emergente explicativa
                    Swal.fire('Precio fuera de rango estadístico', `El precio ingresado debe estar dentro del margen permitido del 10% ($${precioMinPermitido.toLocaleString()} - $${precioMaxPermitido.toLocaleString()} COP).`, 'error');
                    return;
                }
            }

            var formData = $('#formPublicarDemanda').serialize();

            Swal.fire({
                title: '¿Confirmar solicitud y pago?',
                text: "Serás redirigido a la pasarela de pago seguro.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Continuar al Pago',
                cancelButtonText: 'Cancelar',
                background: '#f8f9fa',
                customClass: { popup: 'rounded-4 shadow-lg' }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("GuardarAjax", "PublicarDemanda")',
                        type: 'POST',
                        data: formData,
                        success: function (response) {
                            if (response.exito) {
                                if (response.requierePerfilPago) {
                                    Swal.fire({
                                        icon: 'warning',
                                        title: response.titulo || 'Método de Pago Requerido',
                                        text: response.mensaje,
                                        showCancelButton: true,
                                        confirmButtonColor: '#2e7d32',
                                        cancelButtonColor: '#6c757d',
                                        confirmButtonText: '<i class="bi bi-credit-card me-1"></i> Registrar Perfil de Pago',
                                        cancelButtonText: 'Cancelar',
                                        background: '#f8f9fa',
                                        customClass: {
                                            popup: 'rounded-4 shadow-lg',
                                            confirmButton: 'rounded-pill px-4',
                                            cancelButton: 'rounded-pill px-4'
                                        }
                                    }).then((alertResult) => {
                                        if (alertResult.isConfirmed) {
                                            window.location.href = response.urlPerfilPago;
                                        }
                                        // Si le da clic en Cancelar, se cierra el modal y permanece en el formulario con sus datos
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'success',
                                        title: '¡Validado!',
                                        text: response.mensaje,
                                        timer: 2000,
                                        showConfirmButton: false
                                    }).then(() => {
                                        window.location.href = response.redirectUrl;
                                    });
                                }
                            } else {
                                Swal.fire('Error de validación', response.error, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error de servidor', 'Ocurrió un error inesperado al procesar la solicitud.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}