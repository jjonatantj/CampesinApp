@model CamionFleteDto
@{
    Layout = "_LayoutCasosUso";
    ViewData["Title"] = "Detalle Logístico del Transporte";

    string Estado(bool alDia) => alDia ? "Al día" : "Vencido";
}

<div class="container pb-4">
    <div class="main-container p-4 p-md-5 shadow-sm mx-auto" style="max-width: 44rem;">
        <a asp-controller="PantallaPrincipal" asp-action="Index" class="btn btn-nav-register text-decoration-none mb-3"><i class="bi bi-arrow-left me-1"></i> Regresar</a>

        <h1 class="brand-title fs-2 mb-3" style="color: #1b5e20;">Detalle Logístico del Transporte</h1>

        <div class="feature-card mb-3">
            <h2 class="h6 fw-bold text-success border-bottom pb-2"><i class="bi bi-person-badge me-2"></i>Datos del transportador</h2>
            <p class="mb-1"><strong>Nombre:</strong> @Model.NombreTransportador</p>
            <p class="mb-0"><strong>Teléfono:</strong> @Model.TelefonoTransportador</p>
        </div>

        <div class="feature-card">
            <h2 class="h6 fw-bold text-success border-bottom pb-2"><i class="bi bi-truck me-2"></i>Datos del vehículo</h2>
            <p class="mb-1"><strong>Placa:</strong> @Model.Placa</p>
            <p class="mb-1"><strong>Modelo:</strong> @Model.Modelo</p>
            <p class="mb-2"><strong>Capacidad de carga:</strong> @Model.Capacidad toneladas</p>
            <p class="mb-0 small text-muted">
                Pase: @Estado(Model.PaseAlDia) · Seguro: @Estado(Model.SeguroAlDia) · Tecnomecánica: @Estado(Model.TecnomecanicaAlDia)
            </p>
        </div>
    </div>
</div>
