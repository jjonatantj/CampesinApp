@model AsignacionTransporteDto
@{
    var faltanCampos = ViewData["FaltanCampos"] as bool? == true;
    var errorNegocio = ViewData["ErrorNegocio"] as string;
}
<form method="post" asp-controller="Transporte" asp-action="Asignar" data-ajax-form novalidate>
    <div class="modal-header">
        <h5 class="modal-title">Asignación de Datos de Transporte</h5>
        <button type="button" class="btn-close" data-modal-cerrar="" aria-label="Cerrar"></button>
    </div>
    <div class="modal-body">
        @if (!string.IsNullOrEmpty(errorNegocio))
        {
            <div class="recuadro-error" role="alert">@errorNegocio</div>
        }

        <div class="mb-3">
            <label for="IdDemanda" class="form-label">Pedido</label>
            <select id="IdDemanda" name="IdDemanda" class="form-select @VistaHelpers.ClaseError(ViewData, nameof(Model.IdDemanda))">
                <option value="">Seleccione un pedido sin transporte…</option>
                @foreach (var pedido in Model.Pedidos)
                {
                    <option value="@pedido.Id" selected="@(Model.IdDemanda == pedido.Id)">@pedido.Texto</option>
                }
            </select>
            @if (Model.Pedidos.Count == 0)
            {
                <div class="mensaje-campo">Todos los pedidos ya tienen transporte asignado.</div>
            }
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-7">
                <label for="IdTransportador" class="form-label">Nombre del Transportador</label>
                <select id="IdTransportador" name="IdTransportador" data-copiar-extra="#Telefono"
                        class="form-select @VistaHelpers.ClaseError(ViewData, nameof(Model.IdTransportador))">
                    <option value="">Seleccione…</option>
                    @foreach (var transportador in Model.Transportadores)
                    {
                        <option value="@transportador.Id" data-extra="@transportador.Extra" selected="@(Model.IdTransportador == transportador.Id)">@transportador.Texto</option>
                    }
                </select>
            </div>
            <div class="col-sm-5">
                <label for="Telefono" class="form-label">Teléfono de Contacto</label>
                <input type="text" id="Telefono" name="Telefono" value="@Model.Telefono" maxlength="20" inputmode="tel"
                       class="form-control @VistaHelpers.ClaseError(ViewData, nameof(Model.Telefono))" />
            </div>
        </div>

        <div class="row g-3">
            <div class="col-sm-4">
                <label for="Placa" class="form-label">Placa del Camión</label>
                <input type="text" id="Placa" name="Placa" value="@Model.Placa" maxlength="8" autocomplete="off"
                       class="form-control text-uppercase @VistaHelpers.ClaseError(ViewData, nameof(Model.Placa))" />
            </div>
            <div class="col-sm-4">
                <label for="Modelo" class="form-label">Modelo del Vehículo</label>
                <input type="text" id="Modelo" name="Modelo" value="@Model.Modelo" maxlength="20" autocomplete="off"
                       class="form-control @VistaHelpers.ClaseError(ViewData, nameof(Model.Modelo))" />
            </div>
            <div class="col-sm-4">
                <label for="Capacidad" class="form-label">Capacidad de Carga (kg)</label>
                <input type="number" id="Capacidad" name="Capacidad" value="@Model.Capacidad" min="1" step="1"
                       class="form-control @VistaHelpers.ClaseError(ViewData, nameof(Model.Capacidad))" />
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2 mt-4">
            <button type="submit" class="btn btn-success px-4">Guardar Datos</button>
            <button type="button" class="btn btn-outline-dark" data-modal-cerrar="todas" data-redirigir="/Perfil/Index">Cancelar</button>
        </div>

        @if (faltanCampos)
        {
            <p class="mensaje-formulario" role="alert">Por favor complete todos los campos obligatorios del transporte</p>
        }
    </div>
</form>
