@model CampesinApp.ViewModels.PuntoAcopioViewModel

@{
    ViewData["Title"] = "Registrar Punto de Acopio";
    Layout = "_LayoutCasosUso";
}

<!-- Librería de iconos Bootstrap integrada en el proyecto -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<div class="container py-4 my-4">
    <div class="main-container p-4 p-md-5 rounded-4 shadow-sm">

        <!-- ============================================================== -->
        <!-- ENCABEZADO DE LA VISTA (Estandarizado, sin emojis)             -->
        <!-- ============================================================== -->
        <div class="d-flex align-items-center mb-4">
            <div class="p-3 rounded-circle me-3" style="background-color: #e8f5e9; color: #2e7d32;">
                <i class="bi bi-geo-alt-fill fs-3"></i>
            </div>
            <div>
                <h1 class="brand-title mb-0 fs-2" style="color: #1b5e20;">Registrar Punto de Acopio</h1>
                <p class="text-muted mb-0 fw-semibold">
                    Registra un punto físico de recepción agrícola con georreferenciación en Google Maps.
                </p>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- MENSAJES DE NOTIFICACIÓN TEMPORALES (FE-01, FE-02 Y ÉXITO)     -->
        <!-- ============================================================== -->

        <!-- FE-01-CU018: Notificación de error en servicio o base de datos (6 segundos) -->
        @if (ViewBag.MensajeErrorConexion != null)
        {
            <div id="alertaErrorConexion" class="alert alert-danger shadow-sm border-0 rounded-4 d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-4 me-3 text-danger"></i>
                <div class="flex-grow-1">
                    <strong>Aviso del Sistema:</strong> @ViewBag.MensajeErrorConexion
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <!-- FE-02-CU018: Punto de acopio duplicado en misma dirección (6 segundos) -->
        @if (ViewBag.MensajeErrorDuplicado != null)
        {
            <div id="alertaErrorDuplicado" class="alert alert-warning shadow-sm border-0 rounded-4 d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                <div class="flex-grow-1">
                    <strong>Punto Duplicado:</strong> @ViewBag.MensajeErrorDuplicado
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <!-- Notificación de Éxito: 3 segundos y redirección a Perfil (CU-031) -->
        @if (ViewBag.RegistroExitoso == true)
        {
            <div id="alertaExito" class="alert alert-success shadow-sm border-0 rounded-4 d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                <div class="flex-grow-1">
                    <strong>Registro Exitoso:</strong> @ViewBag.MensajeExito Redireccionando a tu perfil...
                </div>
            </div>
        }

        <!-- Resumen de validaciones de C# / ModelState -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger shadow-sm rounded-4 mb-4">
                <h6 class="fw-bold mb-1"><i class="bi bi-x-circle me-1"></i> Por favor verifique los siguientes campos:</h6>
                <div asp-validation-summary="All" class="small mb-0"></div>
            </div>
        }

        <!-- ============================================================== -->
        <!-- FORMULARIO DE REGISTRO                                         -->
        <!-- ============================================================== -->
        <form asp-controller="PuntoAcopio" asp-action="Registrar" method="post" id="formPuntoAcopio" novalidate>
            @Html.AntiForgeryToken()

            <!-- CAMPOS OCULTOS DE COORDENADAS (Se llenan al hacer clic en el mapa, GPS o arrastrar pin) -->
            <input type="hidden" asp-for="Latitud" id="latitudHidden" />
            <input type="hidden" asp-for="Longitud" id="longitudHidden" />

            <div class="row g-4">

                <!-- ───────────────────────────────────────────────────────── -->
                <!-- COLUMNA IZQUIERDA: FORMULARIO DE DATOS FÍSICOS           -->
                <!-- ───────────────────────────────────────────────────────── -->
                <div class="col-lg-6">
                    <h5 class="fw-bold text-success mb-3 pb-2 border-bottom">
                        <i class="bi bi-building me-1"></i> Datos del Lugar
                    </h5>

                                        <!-- Selector exclusivo para usuario Administrador (CU-018) -->
                    @if (Model.EsAdministrador)
                    {
                        <div class="card border-success-subtle bg-light rounded-4 p-3 mb-3 shadow-sm">
                            <label class="form-label fw-bold small text-dark d-block mb-2">
                                <i class="bi bi-shield-lock-fill text-success me-1"></i> Tipo de Punto de Acopio (Panel Administrador) *
                            </label>
                            <div class="d-flex gap-2">
                                <div class="flex-fill">
                                    <input type="radio" class="btn-check" asp-for="TipoAcopioManual" id="radioTipoCampesino" value="false" checked autocomplete="off">
                                    <label class="btn btn-outline-success w-100 py-2 rounded-pill fw-semibold text-center shadow-none" for="radioTipoCampesino">
                                        <i class="bi bi-person-workspace me-1"></i> Campesino
                                    </label>
                                </div>
                                <div class="flex-fill">
                                    <input type="radio" class="btn-check" asp-for="TipoAcopioManual" id="radioTipoComprador" value="true" autocomplete="off">
                                    <label class="btn btn-outline-primary w-100 py-2 rounded-pill fw-semibold text-center shadow-none" for="radioTipoComprador">
                                        <i class="bi bi-shop me-1"></i> Comprador
                                    </label>
                                </div>
                            </div>
                            <small class="text-muted d-block mt-2" style="font-size: 0.78rem;">
                                Como Administrador, seleccione si este punto pertenece a un productor campesino o a un comprador.
                            </small>
                        </div>
                    }

                    <!-- 1. Nombre del Punto -->
                    <div class="mb-3">
                        <label asp-for="NombrePunto" class="form-label fw-bold small text-dark">Nombre del Punto *</label>
                        <div class="input-group border rounded-pill bg-white overflow-hidden align-items-center shadow-none">
                            <span class="input-group-text bg-transparent border-0 text-success ps-3"><i class="bi bi-tag-fill"></i></span>
                            <input asp-for="NombrePunto" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" placeholder="Ej: Acopio Central La Sabana" maxlength="100" required />
                        </div>
                        <span asp-validation-for="NombrePunto" class="text-danger small ms-2"></span>
                    </div>

                    <!-- 2. Departamento (para filtrado y centrado del mapa) -->
                    <div class="mb-3">
                        <label asp-for="IdDepartamento" class="form-label fw-bold small text-dark">Departamento *</label>
                        <div class="input-group border rounded-pill bg-white overflow-hidden align-items-center shadow-none">
                            <span class="input-group-text bg-transparent border-0 text-success ps-3"><i class="bi bi-map"></i></span>
                            <select asp-for="IdDepartamento" class="form-select border-0 shadow-none px-3 py-2 bg-transparent" id="selectDepartamento" required>
                                <option value="">-- Seleccione un departamento --</option>
                                @foreach (var depto in Model.Departamentos)
                                {
                                    <option value="@depto.Value" selected="@depto.Selected">@depto.Text</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="IdDepartamento" class="text-danger small ms-2"></span>
                    </div>

                    <!-- 3. Municipio (Al cambiar, centra el mapa automáticamente) -->
                    <div class="mb-3">
                        <label asp-for="IdMunicipio" class="form-label fw-bold small text-dark">Municipio *</label>
                        <div class="input-group border rounded-pill bg-white overflow-hidden align-items-center shadow-none">
                            <span class="input-group-text bg-transparent border-0 text-success ps-3"><i class="bi bi-geo"></i></span>
                            <select asp-for="IdMunicipio" class="form-select border-0 shadow-none px-3 py-2 bg-transparent" id="selectMunicipio" required>
                                <option value="">-- Seleccione primero un departamento --</option>
                                @foreach (var mun in Model.Municipios)
                                {
                                    <option value="@mun.Value" selected="@mun.Selected">@mun.Text</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="IdMunicipio" class="text-danger small ms-2"></span>
                    </div>

                    <!-- ============================================================== -->
                    <!-- 4. LÓGICA DINÁMICA DE DIRECCIÓN: SELECTOR DE ZONA (URBANO/RURAL) -->
                    <!-- ============================================================== -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark d-block">
                            <i class="bi bi-compass text-success me-1"></i> Zona de Ubicación *
                        </label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <input type="radio" class="btn-check" name="radioZona" id="radioZonaUrbano" value="Urbano" checked autocomplete="off">
                                <label class="btn btn-outline-success w-100 py-2 rounded-pill fw-semibold text-center shadow-none" for="radioZonaUrbano">
                                    <i class="bi bi-buildings me-1"></i> Urbano
                                </label>
                            </div>
                            <div class="flex-fill">
                                <input type="radio" class="btn-check" name="radioZona" id="radioZonaRural" value="Rural" autocomplete="off">
                                <label class="btn btn-outline-success w-100 py-2 rounded-pill fw-semibold text-center shadow-none" for="radioZonaRural">
                                    <i class="bi bi-tree me-1"></i> Rural
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- ───────────────────────────────────────────────────────────── -->
                    <!-- CONSTRUCTOR DE DIRECCIÓN URBANA POR BLOQUES                   -->
                    <!-- ───────────────────────────────────────────────────────────── -->
                    <div id="bloqueDireccionUrbana" class="card border rounded-4 p-3 bg-white shadow-sm mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-signpost-2-fill text-success me-2"></i>
                            <span class="fw-bold small text-dark">Constructor de Dirección Urbana</span>
                        </div>
                        <p class="text-muted small mb-3" style="font-size: 0.8rem;">
                            Estructure la dirección estándar colombiana (Tipo de vía, número, cruce y placa):
                        </p>

                        <!-- Fila 1: Tipo de vía y Número Principal -->
                        <div class="row g-2 mb-2">
                            <div class="col-sm-6">
                                <label class="form-label small text-muted mb-1">Tipo de Vía *</label>
                                <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                    <select id="urbanoTipoVia" class="form-select border-0 bg-transparent shadow-none px-3 py-1 small">
                                        <option value="Calle">Calle</option>
                                        <option value="Carrera">Carrera</option>
                                        <option value="Diagonal">Diagonal</option>
                                        <option value="Transversal">Transversal</option>
                                        <option value="Avenida">Avenida</option>
                                        <option value="Autopista">Autopista</option>
                                        <option value="Circular">Circular</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small text-muted mb-1">Número de Vía *</label>
                                <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                    <input type="text" id="urbanoNumeroVia" class="form-control border-0 bg-transparent shadow-none px-3 py-1 small" placeholder="Ej: 45" maxlength="15" />
                                </div>
                            </div>
                        </div>

                        <!-- Fila 2: Letra/Sufijo, Cruce (#) y Placa (-) -->
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label small text-muted mb-1">Letra / Bis</label>
                                <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                    <input type="text" id="urbanoLetraVia" class="form-control border-0 bg-transparent shadow-none px-2 py-1 small text-center" placeholder="Ej: A, Sur" maxlength="15" />
                                </div>
                            </div>
                            <div class="col-4">
                                <label class="form-label small text-muted mb-1">Cruce (#) *</label>
                                <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                    <span class="input-group-text bg-transparent border-0 text-muted ps-2 pe-1 small">#</span>
                                    <input type="text" id="urbanoNumeroGenerador" class="form-control border-0 bg-transparent shadow-none px-1 py-1 small text-center" placeholder="Ej: 12" maxlength="15" />
                                </div>
                            </div>
                            <div class="col-4">
                                <label class="form-label small text-muted mb-1">Placa (-) *</label>
                                <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                    <span class="input-group-text bg-transparent border-0 text-muted ps-2 pe-1 small">-</span>
                                    <input type="text" id="urbanoPlaca" class="form-control border-0 bg-transparent shadow-none px-1 py-1 small text-center" placeholder="Ej: 34" maxlength="15" />
                                </div>
                            </div>
                        </div>

                        <!-- Fila 3: Indicación Extra (Urbana) -->
                        <div class="mt-2">
                            <label class="form-label small text-muted mb-1">Indicación extra (Opcional)</label>
                            <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="bi bi-info-circle"></i></span>
                                <input type="text" id="urbanoIndicacionExtra" class="form-control border-0 bg-transparent shadow-none px-3 py-1 small" placeholder="Ej: Casa verde de dos pisos, frente al parque" maxlength="150" value="@Model.Descripcion" />
                            </div>
                            <small class="text-muted d-block mt-1 ps-2" style="font-size: 0.75rem;">
                                <i class="bi bi-info-circle text-secondary me-1"></i> Esta indicación se guarda en la descripción del punto de acopio.
                            </small>
                        </div>
                    </div>

                    <!-- ───────────────────────────────────────────────────────────── -->
                    <!-- CONSTRUCTOR DE DIRECCIÓN RURAL POR BLOQUES                    -->
                    <!-- ───────────────────────────────────────────────────────────── -->
                    <div id="bloqueDireccionRural" class="card border rounded-4 p-3 bg-white shadow-sm mb-3" style="display: none;">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-tree-fill text-success me-2"></i>
                            <span class="fw-bold small text-dark">Ubicación en Zona Rural</span>
                        </div>
                        <p class="text-muted small mb-3" style="font-size: 0.8rem;">
                            Indique el nombre de la vereda o sector rural donde opera el punto de acopio:
                        </p>

                        <!-- Fila 1: Nombre de Vereda -->
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Nombre de Vereda *</label>
                            <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                <span class="input-group-text bg-transparent border-0 text-success ps-3"><i class="bi bi-geo-alt"></i></span>
                                <input type="text" id="ruralNombreVereda" class="form-control border-0 bg-transparent shadow-none px-3 py-1 small" placeholder="Ej: El Rosal, La Esperanza, San Isidro" maxlength="100" />
                            </div>
                        </div>

                        <!-- Fila 2: Indicación Extra (Rural) -->
                        <div class="mt-2">
                            <label class="form-label small text-muted mb-1">Indicación extra (Opcional)</label>
                            <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="bi bi-info-circle"></i></span>
                                <input type="text" id="ruralIndicacionExtra" class="form-control border-0 bg-transparent shadow-none px-3 py-1 small" placeholder="Ej: Finca El Paraíso, a 300m de la escuela rural" maxlength="150" value="@Model.Descripcion" />
                            </div>
                            <small class="text-muted d-block mt-1 ps-2" style="font-size: 0.75rem;">
                                <i class="bi bi-info-circle text-secondary me-1"></i> Esta indicación se guarda en la descripción del punto de acopio.
                            </small>
                        </div>
                    </div>

                    <!-- CAMPO OCULTO QUE CONCATENA LA DIRECCIÓN PRINCIPAL PARA LA BASE DE DATOS (varchar 150) -->
                    <input type="hidden" asp-for="Direccion" id="inputDireccion" />
                    <input type="hidden" asp-for="Descripcion" id="inputDescripcion" />

                    <!-- RECUADRO DE VISTA PREVIA Y ACCIONES DE UBICACIÓN -->
                    <div class="card p-3 border-success-subtle bg-light rounded-4 mb-3 shadow-sm">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center text-success mb-1">
                                    <i class="bi bi-signpost-split-fill me-2 fs-5"></i>
                                    <span class="fw-bold small">Dirección estructurada para el sistema:</span>
                                </div>
                                <div id="textoDireccionGenerada" class="fw-bold text-dark ps-4 small font-monospace">
                                    (Diligencie los campos anteriores para armar la dirección)
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <!-- Botón para Zona Urbana: Geocodifica la dirección con Google Geocoder -->
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 py-1 shadow-sm text-white" id="btnGeocodificarDireccion" style="background-color: #2e7d32; border-color: #2e7d32;">
                                    <i class="bi bi-geo-alt-fill me-1"></i> Ubicar en Mapa
                                </button>

                                <!-- Botón de GPS "Mi Ubicación Actual" reubicado aquí (mismo funcionamiento) -->
                                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 shadow-sm fw-semibold" id="btnUbicacionActualGPS" title="Centrar mapa en la posición GPS de tu teléfono o computador">
                                    <i class="bi bi-crosshair me-1"></i> Mi Ubicación Actual
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="Direccion" class="text-danger small mt-1 ps-4 d-block"></span>
                    </div>

                    <!-- 5. Teléfono de Contacto -->
                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label fw-bold small text-dark">Teléfono de Contacto *</label>
                        <div class="input-group border rounded-pill bg-white overflow-hidden align-items-center shadow-none">
                            <span class="input-group-text bg-transparent border-0 text-success ps-3"><i class="bi bi-telephone"></i></span>
                            <input asp-for="Telefono" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" placeholder="Ej: 3101234567 (7 a 10 dígitos)" minlength="7" maxlength="10" inputmode="numeric" pattern="[0-9]{7,10}" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                        </div>
                        <span asp-validation-for="Telefono" class="text-danger small ms-2"></span>
                    </div>

                    <!-- ============================================================== -->
                    <!-- 6. HORARIO DE ATENCIÓN ESTRUCTURADO (DÍAS + HORAS INICIO/FIN)  -->
                    <!-- ============================================================== -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark mb-1 d-block">
                            <i class="bi bi-clock-fill text-success me-1"></i> Horario de Atención *
                        </label>

                        <div class="card border rounded-4 p-3 bg-white shadow-sm">
                            <small class="text-muted fw-semibold mb-2 d-block">
                                Seleccione los días hábiles de atención:
                            </small>

                            <!-- Días Hábiles (Lunes a Domingo) tipo toggle buttons -->
                            <div class="d-flex flex-wrap gap-1 mb-3" id="grupoDiasSemana">
                                <div>
                                    <input type="checkbox" class="btn-check dia-horario-check" id="checkDiaLun" value="Lun" data-index="0" checked autocomplete="off">
                                    <label class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-semibold" for="checkDiaLun">Lun</label>
                                </div>
                                <div>
                                    <input type="checkbox" class="btn-check dia-horario-check" id="checkDiaMar" value="Mar" data-index="1" checked autocomplete="off">
                                    <label class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-semibold" for="checkDiaMar">Mar</label>
                                </div>
                                <div>
                                    <input type="checkbox" class="btn-check dia-horario-check" id="checkDiaMie" value="Mié" data-index="2" checked autocomplete="off">
                                    <label class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-semibold" for="checkDiaMie">Mié</label>
                                </div>
                                <div>
                                    <input type="checkbox" class="btn-check dia-horario-check" id="checkDiaJue" value="Jue" data-index="3" checked autocomplete="off">
                                    <label class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-semibold" for="checkDiaJue">Jue</label>
                                </div>
                                <div>
                                    <input type="checkbox" class="btn-check dia-horario-check" id="checkDiaVie" value="Vie" data-index="4" checked autocomplete="off">
                                    <label class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-semibold" for="checkDiaVie">Vie</label>
                                </div>
                                <div>
                                    <input type="checkbox" class="btn-check dia-horario-check" id="checkDiaSab" value="Sáb" data-index="5" autocomplete="off">
                                    <label class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-semibold" for="checkDiaSab">Sáb</label>
                                </div>
                                <div>
                                    <input type="checkbox" class="btn-check dia-horario-check" id="checkDiaDom" value="Dom" data-index="6" autocomplete="off">
                                    <label class="btn btn-outline-success btn-sm rounded-pill px-3 py-1 fw-semibold" for="checkDiaDom">Dom</label>
                                </div>
                            </div>

                            <!-- Inputs nativos de reloj para Hora de Inicio y Hora de Cierre -->
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Hora de inicio *</label>
                                    <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                        <span class="input-group-text bg-transparent border-0 text-success ps-3"><i class="bi bi-sunrise"></i></span>
                                        <input type="time" id="inputHoraInicio" class="form-control border-0 bg-transparent shadow-none px-2 py-1 small" value="08:00" required />
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Hora de cierre *</label>
                                    <div class="input-group border rounded-pill bg-light overflow-hidden align-items-center">
                                        <span class="input-group-text bg-transparent border-0 text-success ps-3"><i class="bi bi-sunset"></i></span>
                                        <input type="time" id="inputHoraCierre" class="form-control border-0 bg-transparent shadow-none px-2 py-1 small" value="17:00" required />
                                    </div>
                                </div>
                            </div>

                            <!-- CAMPO OCULTO QUE CONCATENA EL HORARIO PARA LA BASE DE DATOS (varchar 80) -->
                            <input type="hidden" asp-for="HorarioAtencion" id="inputHorarioAtencion" />

                            <!-- Vista previa del Horario generado -->
                            <div class="bg-light p-2 rounded-3 border mt-2">
                                <small class="text-muted d-block" style="font-size: 0.75rem;">Horario estructurado para la base de datos:</small>
                                <strong id="textoHorarioGenerado" class="text-success small font-monospace">Lun-Vie: 08:00 - 17:00</strong>
                            </div>
                            <span asp-validation-for="HorarioAtencion" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- 7. Capacidad de Almacenamiento -->
                    <div class="mb-3">
                        <label asp-for="Capacidad" class="form-label fw-bold small text-dark">Capacidad de Almacenamiento (Kg) *</label>
                        <div class="input-group border rounded-pill bg-white overflow-hidden align-items-center shadow-none">
                            <span class="input-group-text bg-transparent border-0 text-success ps-3"><i class="bi bi-box-seam"></i></span>
                            <input asp-for="Capacidad" type="number" step="0.01" min="1" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" placeholder="Ej: 20000" data-val="true" data-val-required="La capacidad estimada es obligatoria." data-val-range="La capacidad debe ser un número positivo mayor o igual a 1 Kg." data-val-range-min="1" data-val-range-max="10000000" required />
                            <span class="input-group-text bg-light border-0 text-muted pe-3 fw-bold">Kg</span>
                        </div>
                        <span asp-validation-for="Capacidad" class="text-danger small ms-2"></span>
                    </div>

                    <!-- 8. Acceso Vehicular por defecto habilitado (RN-02-CU018) -->
                    <input type="hidden" asp-for="AccesoVehicular" value="true" />

                </div>

                <!-- ───────────────────────────────────────────────────────── -->
                <!-- COLUMNA DERECHA: MAPA INTERACTIVO GOOGLE MAPS            -->
                <!-- ───────────────────────────────────────────────────────── -->
                <div class="col-lg-6">
                    <div class="sticky-top" style="top: 1.5rem; z-index: 10;">
                        <h5 class="fw-bold text-success mb-3 pb-2 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <span><i class="bi bi-map-fill me-1"></i> Ubicación Geográfica en el Mapa</span>
                            <span class="badge bg-success text-dark small fw-normal py-1 px-2 rounded-pill">
                                <i class="bi bi-globe-americas me-1"></i> Vista Satelital
                            </span>
                        </h5>

                        <!-- Contenedor del Mapa de Google Maps redondeado en Vista Satelital -->
                        <div id="map" style="width: 100%; height: 480px; background-color: #f1f3f5;" class="border shadow-sm mb-3 position-relative rounded-4 overflow-hidden">
                            <div id="mapLoading" class="position-absolute top-50 start-50 translate-middle text-muted small text-center">
                                <div class="spinner-border text-success spinner-border-sm mb-2" role="status"></div>
                                <div>Cargando Google Maps...</div>
                            </div>
                        </div>

                        <!-- Indicador visual amigable del punto marcado (Sin emojis) -->
                        <div id="indicadorUbicacion" class="alert alert-light border rounded-pill d-flex align-items-center py-2 px-3 mb-2 shadow-sm">
                            <i class="bi bi-geo-alt-fill fs-4 me-2 text-success"></i>
                            <div class="small">
                                <span id="textoCoordenadas" class="fw-semibold text-secondary">
                                    Ningún punto marcado aún. Digite la dirección, use "Mi Ubicación Actual" o haga clic en el mapa.
                                </span>
                            </div>
                        </div>

                        <span asp-validation-for="Latitud" class="text-danger small d-block ms-2"></span>
                        <span asp-validation-for="Longitud" class="text-danger small d-block ms-2"></span>
                    </div>
                </div>

            </div>

            <!-- ============================================================== -->
            <!-- BOTONES DE ACCIÓN: Cancelar y Guardar con estilo rounded-pill  -->
            <!-- ============================================================== -->
            <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top flex-wrap gap-2">
                <!-- Botón Cancelar -->
                <a asp-controller="Perfil" asp-action="Index" class="btn btn-secondary px-4 py-2 fw-semibold rounded-pill shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Cancelar
                </a>

                <!-- Botón Guardar Punto de Acopio -->
                <button type="submit" class="btn btn-success px-5 py-2 fw-bold rounded-pill text-white shadow-sm" id="btnGuardar" style="background-color: #2e7d32; border-color: #2e7d32;">
                    <i class="bi bi-check-circle me-1"></i> Guardar Punto de Acopio
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <!-- Validaciones estándar de ASP.NET Core MVC -->
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Carga de la API de Google Maps JavaScript -->
    @if (!string.IsNullOrEmpty(Model.GoogleMapsApiKey))
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&callback=initMap&loading=async" async defer></script>
    }

    <script>
        // =========================================================================
        // VARIABLES GLOBALES DE GOOGLE MAPS
        // =========================================================================
        let map;        // Instancia del mapa interactivo
        let marker;     // Marcador (Pin arrastrable)
        let geocoder;   // Servicio Geocoder de Google Maps para convertir direcciones urbanas en coordenadas

        // Coordenadas iniciales por defecto (Centro geográfico de Colombia)
        const latDefault = 4.570868;
        const lngDefault = -74.297333;

        // =========================================================================
        // 1. INICIALIZACIÓN DEL MAPA EN VISTA SATELITAL (Requerimiento 2)
        // =========================================================================
        function initMap() {
            const mapContainer = document.getElementById('map');
            const mapLoading = document.getElementById('mapLoading');
            if (mapLoading) mapLoading.style.display = 'none';

            // Instanciamos el Geocoder de Google Maps
            geocoder = new google.maps.Geocoder();

            // Verificamos si los campos ocultos ya tenían coordenadas (por ejemplo al recargar por validación)
            const latPrevia = parseFloat(document.getElementById('latitudHidden').value);
            const lngPrevia = parseFloat(document.getElementById('longitudHidden').value);
            const tieneCoordenadas = !isNaN(latPrevia) && !isNaN(lngPrevia) && latPrevia !== 0;

            const puntoInicial = tieneCoordenadas ? { lat: latPrevia, lng: lngPrevia } : { lat: latDefault, lng: lngDefault };

            // REQUERIMIENTO: Cargar por defecto en vista satelital con etiquetas (mapTypeId: 'hybrid')
            map = new google.maps.Map(mapContainer, {
                center: puntoInicial,
                zoom: tieneCoordenadas ? 16 : 6,
                mapTypeId: 'hybrid',     // Vista satelital con etiquetas de vías y lugares por defecto
                mapTypeControl: true,    // Permite al usuario alternar entre satélite y mapa regular
                streetViewControl: false,
                zoomControl: true
            });

            // Si ya existían coordenadas previas, creamos el marcador
            if (tieneCoordenadas) {
                fijarMarcador(puntoInicial);
            }

            // =====================================================================
            // EVENTO DE CLIC EN EL MAPA:
            // Coloca el marcador en el punto seleccionado y actualiza las coordenadas
            // sin alterar ni sobrescribir los textos de dirección ingresados.
            // =====================================================================
            map.addListener('click', function (event) {
                fijarMarcador(event.latLng);
            });
        }
        window.initMap = initMap;

        // =========================================================================
        // 2. FUNCIÓN PARA FIJAR/MOVER EL MARCADOR (draggable: true)
        // INDEPENDENCIA DEL MARCADOR: NO altera los campos de texto de la dirección.
        // =========================================================================
        function fijarMarcador(latLng, autocompletarUrbano = true) {
            const lat = typeof latLng.lat === 'function' ? latLng.lat() : latLng.lat;
            const lng = typeof latLng.lng === 'function' ? latLng.lng() : latLng.lng;

            if (!marker) {
                // Instanciamos el marcador como ARRASTRABLE (draggable: true)
                marker = new google.maps.Marker({
                    position: { lat: lat, lng: lng },
                    map: map,
                    draggable: true, // Requerimiento: Arrastrable para corrección manual
                    animation: google.maps.Animation.DROP,
                    title: "Ubicación del Punto de Acopio"
                });

                // Al arrastrar y soltar el marcador:
                marker.addListener('dragend', function (event) {
                    actualizarCamposOcultos(event.latLng.lat(), event.latLng.lng());
                    if (obtenerZonaSeleccionada() === 'Urbano') {
                        autocompletarDireccionUrbanaDesdeCoordenadas(event.latLng.lat(), event.latLng.lng());
                    }
                });
            } else {
                marker.setPosition({ lat: lat, lng: lng });
            }

            actualizarCamposOcultos(lat, lng);

            // Requerimiento: Al seleccionar un punto en el mapa y estar en Urbano, llena los campos de la dirección
            if (autocompletarUrbano && obtenerZonaSeleccionada() === 'Urbano') {
                autocompletarDireccionUrbanaDesdeCoordenadas(lat, lng);
            }
        }

        // =========================================================================
        // AUTOCOMPLETAR DIRECCIÓN URBANA DESDE COORDENADAS (GEOCODER INVERSO)
        // Solo aplica en zona Urbana. El usuario puede luego editar los campos libremente
        // sin que eso altere o mueva el marcador fijado en el mapa.
        // =========================================================================
        function autocompletarDireccionUrbanaDesdeCoordenadas(lat, lng) {
            if (!geocoder) return;

            geocoder.geocode({ location: { lat: lat, lng: lng } }, function (results, status) {
                if (status === 'OK' && results && results[0]) {
                    const direccionFormateada = results[0].formatted_address || '';
                    const partes = direccionFormateada.split(',');
                    const callePrincipal = partes[0] ? partes[0].trim() : '';

                    if (!callePrincipal) return;

                    // Normalización de prefijos colombianos habituales
                    let calleNormalizada = callePrincipal
                        .replace(/^Cl\.\s*/i, 'Calle ')
                        .replace(/^Cra\.\s*/i, 'Carrera ')
                        .replace(/^Kra\.\s*/i, 'Carrera ')
                        .replace(/^Cr\.\s*/i, 'Carrera ')
                        .replace(/^Dg\.\s*/i, 'Diagonal ')
                        .replace(/^Diag\.\s*/i, 'Diagonal ')
                        .replace(/^Tv\.\s*/i, 'Transversal ')
                        .replace(/^Trans\.\s*/i, 'Transversal ')
                        .replace(/^Av\.\s*/i, 'Avenida ')
                        .replace(/^Autop\.\s*/i, 'Autopista ')
                        .replace(/^Cq\.\s*/i, 'Circular ');

                    // Formato: "Calle 45 # 12-34"
                    const regexCol = /^(Calle|Carrera|Diagonal|Transversal|Avenida|Autopista|Circular)\s+([0-9]+[a-zA-Z]?)(?:\s+([a-zA-Z]+))?\s*#\s*([0-9]+[a-zA-Z]?)(?:\s*-\s*([0-9]+))?/i;
                    const match = calleNormalizada.match(regexCol);

                    if (match) {
                        const tipoVia = match[1];
                        const numVia = match[2] || '';
                        const letra = match[3] || '';
                        const numGen = match[4] || '';
                        const placa = match[5] || '';

                        const selTipo = document.getElementById('urbanoTipoVia');
                        if (selTipo) {
                            for (let i = 0; i < selTipo.options.length; i++) {
                                if (selTipo.options[i].value.toLowerCase() === tipoVia.toLowerCase()) {
                                    selTipo.selectedIndex = i;
                                    break;
                                }
                            }
                        }

                        if (document.getElementById('urbanoNumeroVia')) document.getElementById('urbanoNumeroVia').value = numVia;
                        if (document.getElementById('urbanoLetraVia')) document.getElementById('urbanoLetraVia').value = letra;
                        if (document.getElementById('urbanoNumeroGenerador')) document.getElementById('urbanoNumeroGenerador').value = numGen;
                        if (document.getElementById('urbanoPlaca')) document.getElementById('urbanoPlaca').value = placa;
                    } else {
                        // Si no cumple el formato con numeral, se asigna al campo de número/nombre de vía
                        if (document.getElementById('urbanoNumeroVia')) {
                            document.getElementById('urbanoNumeroVia').value = callePrincipal;
                        }
                    }

                    // Se actualiza la dirección para el modelo sin mover el mapa
                    construirDireccion();
                }
            });
        }

        // Asigna los valores a los inputs ocultos de latitud y longitud y actualiza el indicador visual
        function actualizarCamposOcultos(lat, lng) {
            const latFormatted = lat.toFixed(7);
            const lngFormatted = lng.toFixed(7);

            document.getElementById('latitudHidden').value = latFormatted;
            document.getElementById('longitudHidden').value = lngFormatted;

            const texto = document.getElementById('textoCoordenadas');
            if (texto) {
                texto.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Coordenadas capturadas:</span> Lat: <code>${latFormatted}</code>, Lng: <code>${lngFormatted}</code>`;
            }
        }

        // =========================================================================
        // 3. GEOCODIFICACIÓN DE DIRECCIÓN URBANA EN GOOGLE MAPS
        // En zona rural NO se ejecuta porque las veredas no existen en Google Maps.
        // =========================================================================
        function geocodificarDireccionActual(mostrarAlertaSiVacio = false) {
            const zona = obtenerZonaSeleccionada();

            // En zona rural no se geocodifica la vereda en Google Maps para evitar errores
            if (zona === 'Rural') {
                return;
            }

            const direccion = document.getElementById('inputDireccion').value.trim();
            const selectDepto = document.getElementById('selectDepartamento');
            const selectMun = document.getElementById('selectMunicipio');

            const deptoTexto = selectDepto.options[selectDepto.selectedIndex]?.text.trim() || '';
            const munTexto = selectMun.options[selectMun.selectedIndex]?.text.trim() || '';

            if (!direccion) {
                if (mostrarAlertaSiVacio) {
                    alert('Por favor complete los campos de la dirección urbana antes de ubicar en el mapa.');
                }
                return;
            }

            const municipioValido = munTexto && !munTexto.includes('--');
            const deptoValido = deptoTexto && !deptoTexto.includes('--');

            // Construcción de la consulta urbana para Google Geocoder
            let consulta = direccion;
            if (municipioValido) consulta += `, ${munTexto}`;
            if (deptoValido) consulta += `, ${deptoTexto}`;
            consulta += ', Colombia';

            if (geocoder && map) {
                geocoder.geocode({ address: consulta, componentRestrictions: { country: 'CO' } }, function (results, status) {
                    if (status === 'OK' && results && results[0]) {
                        const ubicacion = results[0].geometry.location;
                        map.setCenter(ubicacion);
                        map.setZoom(16);
                        fijarMarcador(ubicacion, false);
                    } else {
                        // FALLBACK: Si no reconoce la dirección exacta, centrar en el Municipio seleccionado
                        centrarMapa('municipio');
                    }
                });
            } else {
                centrarMapa('municipio');
            }
        }

        // =========================================================================
        // 4. UBICACIÓN ACTUAL POR GPS DEL NAVEGADOR (HTML5 Geolocation API)
        // Solución nativa y gratuita: NO requiere APIs adicionales de Google Cloud.
        // Ubica al campesino en su punto GPS exacto sin tocar la vereda escrita.
        // =========================================================================
        function obtenerUbicacionActualGPS() {
            if (!navigator.geolocation) {
                alert('Su dispositivo o navegador no soporta geolocalización por GPS.');
                return;
            }

            const textoCoords = document.getElementById('textoCoordenadas');
            if (textoCoords) {
                textoCoords.innerHTML = `<span class="text-primary fw-semibold"><span class="spinner-border spinner-border-sm me-1" role="status"></span> Obteniendo ubicación GPS del dispositivo...</span>`;
            }

            navigator.geolocation.getCurrentPosition(
                function (posicion) {
                    const lat = posicion.coords.latitude;
                    const lng = posicion.coords.longitude;
                    const punto = { lat: lat, lng: lng };

                    if (map) {
                        map.setCenter(punto);
                        map.setZoom(17); // Vista satelital cercana para que el campesino distinga su finca o galpón
                    }

                    // Coloca el marcador arrastrable en las coordenadas GPS
                    fijarMarcador(punto);

                    // IMPORTANTE: NO altera ni sobrescribe el nombre de vereda o indicación digitada
                },
                function (error) {
                    let mensajeError = 'No fue posible obtener su ubicación actual.';
                    switch (error.code) {
                        case error.PERMISSION_DENIED:
                            mensajeError = 'Permiso de ubicación denegado. Active el GPS o conceda permisos de ubicación en su navegador, o haga clic directamente sobre el mapa.';
                            break;
                        case error.POSITION_UNAVAILABLE:
                            mensajeError = 'La señal GPS no está disponible en este momento. Puede hacer clic sobre el mapa para ubicar el punto.';
                            break;
                        case error.TIMEOUT:
                            mensajeError = 'Se agotó el tiempo esperando la señal GPS. Intente nuevamente o haga clic sobre el mapa.';
                            break;
                    }
                    alert(mensajeError);

                    // Si no había coordenadas previas, restaurar mensaje de ayuda
                    const latPrev = parseFloat(document.getElementById('latitudHidden').value);
                    if (isNaN(latPrev) || latPrev === 0) {
                        if (textoCoords) {
                            textoCoords.innerHTML = `<span class="text-secondary">Ningún punto marcado aún. Digite la dirección o haga clic en el mapa.</span>`;
                        }
                    }
                },
                {
                    enableHighAccuracy: true, // Máxima precisión con antena GPS del teléfono
                    timeout: 12000,
                    maximumAge: 0
                }
            );
        }

        // =========================================================================
        // 5. LÓGICA DINÁMICA DE LA DIRECCIÓN (URBANO VS RURAL) (Requerimiento 1)
        // =========================================================================
        function obtenerZonaSeleccionada() {
            const radioRural = document.getElementById('radioZonaRural');
            return (radioRural && radioRural.checked) ? 'Rural' : 'Urbano';
        }

        function actualizarDescripcion() {
            const zona = obtenerZonaSeleccionada();
            const inputUrbano = document.getElementById('urbanoIndicacionExtra');
            const inputRural = document.getElementById('ruralIndicacionExtra');
            const valor = (zona === 'Urbano') ? (inputUrbano?.value.trim() || '') : (inputRural?.value.trim() || '');

            const inputDesc = document.getElementById('inputDescripcion');
            if (inputDesc) {
                inputDesc.value = valor;
            }
            return valor;
        }

        function alternarZonaDireccion() {
            const zona = obtenerZonaSeleccionada();
            const bloqueUrbano = document.getElementById('bloqueDireccionUrbana');
            const bloqueRural = document.getElementById('bloqueDireccionRural');
            const btnGeocodificar = document.getElementById('btnGeocodificarDireccion');

            if (zona === 'Rural') {
                bloqueUrbano.style.display = 'none';
                bloqueRural.style.display = 'block';

                // En zona rural se oculta el botón de geocodificar dirección por vía/calle
                if (btnGeocodificar) btnGeocodificar.style.display = 'none';

                const valUrbano = document.getElementById('urbanoIndicacionExtra')?.value || '';
                const ruralExtra = document.getElementById('ruralIndicacionExtra');
                if (valUrbano && ruralExtra && !ruralExtra.value) {
                    ruralExtra.value = valUrbano;
                }
            } else {
                bloqueUrbano.style.display = 'block';
                bloqueRural.style.display = 'none';

                // En zona urbana se reactiva el botón "Ubicar en Mapa"
                if (btnGeocodificar) btnGeocodificar.style.display = 'inline-block';

                const valRural = document.getElementById('ruralIndicacionExtra')?.value || '';
                const urbanoExtra = document.getElementById('urbanoIndicacionExtra');
                if (valRural && urbanoExtra && !urbanoExtra.value) {
                    urbanoExtra.value = valRural;
                }
            }

            construirDireccion();
            actualizarDescripcion();
        }

        // Concatena los campos de la dirección en una sola cadena limpia para varchar(150)
        // IMPORTANTE: Se ignora la "Indicación extra" para la base de datos y mapa por restricción arquitectónica
        function construirDireccion() {
            const zona = obtenerZonaSeleccionada();
            let direccionFinal = '';

            if (zona === 'Urbano') {
                const tipoVia = document.getElementById('urbanoTipoVia')?.value.trim() || 'Calle';
                const numeroVia = document.getElementById('urbanoNumeroVia')?.value.trim() || '';
                const letraVia = document.getElementById('urbanoLetraVia')?.value.trim() || '';
                const numeroGen = document.getElementById('urbanoNumeroGenerador')?.value.trim() || '';
                const placa = document.getElementById('urbanoPlaca')?.value.trim() || '';

                if (numeroVia) {
                    direccionFinal = tipoVia + ' ' + numeroVia;
                    if (letraVia) direccionFinal += ' ' + letraVia;
                    if (numeroGen) direccionFinal += ' # ' + numeroGen;
                    if (placa) direccionFinal += '-' + placa;
                }
            } else {
                const vereda = document.getElementById('ruralNombreVereda')?.value.trim() || '';
                if (vereda) {
                    direccionFinal = vereda.toLowerCase().startsWith('vereda') ? vereda : ('Vereda ' + vereda);
                }
            }

            // Asignación al campo oculto del modelo (para enviar en el POST a la BD)
            document.getElementById('inputDireccion').value = direccionFinal;

            // Actualización de la vista previa en pantalla
            const vistaPrevia = document.getElementById('textoDireccionGenerada');
            if (vistaPrevia) {
                if (direccionFinal) {
                    vistaPrevia.textContent = direccionFinal;
                    vistaPrevia.classList.remove('text-dark');
                    vistaPrevia.classList.add('text-success');
                } else {
                    vistaPrevia.textContent = '(Diligencie los campos anteriores para armar la dirección)';
                    vistaPrevia.classList.remove('text-success');
                    vistaPrevia.classList.add('text-dark');
                }
            }

            return direccionFinal;
        }

        // =========================================================================
        // 6. LÓGICA ESTRUCTURADA DEL HORARIO DE ATENCIÓN (Requerimiento 3)
        // Concatena días hábiles y horas inicio/cierre en una cadena legible para varchar(80)
        // Ej: "Lun-Vie: 08:00 - 17:00" o "Lun, Mié, Vie: 08:00 - 16:00"
        // =========================================================================
        function construirHorario() {
            const checkboxes = Array.from(document.querySelectorAll('.dia-horario-check'));
            const seleccionados = checkboxes.filter(cb => cb.checked);

            if (seleccionados.length === 0) {
                document.getElementById('inputHorarioAtencion').value = '';
                const textoVisual = document.getElementById('textoHorarioGenerado');
                if (textoVisual) textoVisual.textContent = 'Ningún día seleccionado';
                return '';
            }

            const horaIni = document.getElementById('inputHoraInicio')?.value || '08:00';
            const horaFin = document.getElementById('inputHoraCierre')?.value || '17:00';

            // Verificamos si los días seleccionados son un bloque continuo (ej: Lun a Vie, Lun a Sáb)
            let diasTexto = '';
            const indices = seleccionados.map(cb => parseInt(cb.getAttribute('data-index'), 10));
            const esConsecutivo = indices.every((val, i, arr) => i === 0 || val === arr[i - 1] + 1);

            if (esConsecutivo && seleccionados.length >= 3) {
                diasTexto = `${seleccionados[0].value}-${seleccionados[seleccionados.length - 1].value}`;
            } else {
                diasTexto = seleccionados.map(cb => cb.value).join(', ');
            }

            const horarioFormateado = `${diasTexto}: ${horaIni} - ${horaFin}`;

            // Asignación al campo oculto para la BD (varchar 80)
            document.getElementById('inputHorarioAtencion').value = horarioFormateado;

            // Actualización visual en la UI
            const textoVisual = document.getElementById('textoHorarioGenerado');
            if (textoVisual) {
                textoVisual.textContent = horarioFormateado;
            }

            return horarioFormateado;
        }

        // =========================================================================
        // 7. COORDENADAS POR DEFECTO DE DEPARTAMENTOS Y CENTRADO DE MAPA (FALLBACK)
        // =========================================================================
        const coordenadasDepartamentos = {
            "cundinamarca": { lat: 4.86, lng: -74.05, zoom: 9 },
            "antioquia": { lat: 6.95, lng: -75.40, zoom: 8 },
            "boyaca": { lat: 5.65, lng: -73.25, zoom: 8 },
            "boyacá": { lat: 5.65, lng: -73.25, zoom: 8 },
            "santander": { lat: 6.90, lng: -73.25, zoom: 8 },
            "norte de santander": { lat: 8.00, lng: -73.00, zoom: 8 },
            "tolima": { lat: 4.25, lng: -75.15, zoom: 8 },
            "huila": { lat: 2.65, lng: -75.50, zoom: 8 },
            "meta": { lat: 3.50, lng: -73.50, zoom: 8 },
            "caldas": { lat: 5.30, lng: -75.35, zoom: 9 },
