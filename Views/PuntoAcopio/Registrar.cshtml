        function centrarMapa(tipo) {
            if (!map) return;

            const selectDepto = document.getElementById('selectDepartamento');
            const selectMun = document.getElementById('selectMunicipio');

            const deptoTexto = selectDepto.options[selectDepto.selectedIndex]?.text.trim() || '';
            const munTexto = selectMun.options[selectMun.selectedIndex]?.text.trim() || '';

            // 1. Si se eligió o cambió el Departamento: centrar y enfocar en el departamento
            if (tipo === 'departamento' || (!munTexto || munTexto.includes('--'))) {
                if (!deptoTexto || deptoTexto.includes('--')) return;

                const clave = deptoTexto.toLowerCase();
                if (coordenadasDepartamentos[clave]) {
                    const depto = coordenadasDepartamentos[clave];
                    map.setCenter({ lat: depto.lat, lng: depto.lng });
                    map.setZoom(depto.zoom);
                    return;
                }
            }

            // 2. Si se seleccionó un Municipio: centrar vista en ese municipio
            if (munTexto && !munTexto.includes('--')) {
                const consulta = `${munTexto}, ${deptoTexto}, Colombia`;

                if (geocoder) {
                    geocoder.geocode({ address: consulta, componentRestrictions: { country: 'CO' } }, function (results, status) {
                        if (status === 'OK' && results && results[0]) {
                            map.setCenter(results[0].geometry.location);
                            map.setZoom(14);
                        } else {
                            geocodificarMunicipioFallback(consulta);
                        }
                    });
                } else {
                    geocodificarMunicipioFallback(consulta);
                }
            }
        }

        // Fallback garantizado: obtiene las coordenadas del municipio por Nominatim si falla Google Geocoder
        function geocodificarMunicipioFallback(consulta) {
            const url = `https://nominatim.openstreetmap.org/search?format=json&countrycodes=co&q=${encodeURIComponent(consulta)}`;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data && data.length > 0) {
                        const lat = parseFloat(data[0].lat);
                        const lng = parseFloat(data[0].lon);
                        map.setCenter({ lat: lat, lng: lng });
                        map.setZoom(14);
                    }
                })
                .catch(err => {
                    console.warn("No fue posible geocodificar el municipio por fallback:", err);
                });
        }

        // =========================================================================
        // 8. ASIGNACIÓN DE EVENTOS Y CONTROL DE LA INTERFAZ
        // =========================================================================
        document.addEventListener('DOMContentLoaded', function () {

            // A. Cambio de Zona (Urbano vs Rural)
            const radioUrbano = document.getElementById('radioZonaUrbano');
            const radioRural = document.getElementById('radioZonaRural');
            if (radioUrbano) radioUrbano.addEventListener('change', alternarZonaDireccion);
            if (radioRural) radioRural.addEventListener('change', alternarZonaDireccion);

            // B. Inputs del constructor Urbano
            const urbanoInputs = ['urbanoTipoVia', 'urbanoNumeroVia', 'urbanoLetraVia', 'urbanoNumeroGenerador', 'urbanoPlaca'];
            urbanoInputs.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.addEventListener('input', construirDireccion);
                    el.addEventListener('change', construirDireccion);
                }
            });

            // C. Inputs del constructor Rural
            const ruralInput = document.getElementById('ruralNombreVereda');
            if (ruralInput) {
                ruralInput.addEventListener('input', construirDireccion);
                ruralInput.addEventListener('change', construirDireccion);
            }

            // Indicación extra (Descripción del punto)
            const inputDescUrbano = document.getElementById('urbanoIndicacionExtra');
            if (inputDescUrbano) {
                inputDescUrbano.addEventListener('input', actualizarDescripcion);
                inputDescUrbano.addEventListener('change', actualizarDescripcion);
            }
            const inputDescRural = document.getElementById('ruralIndicacionExtra');
            if (inputDescRural) {
                inputDescRural.addEventListener('input', actualizarDescripcion);
                inputDescRural.addEventListener('change', actualizarDescripcion);
            }

            // D. Botón explícito para ubicar la dirección urbana en el mapa
            const btnGeocodificar = document.getElementById('btnGeocodificarDireccion');
            if (btnGeocodificar) {
                btnGeocodificar.addEventListener('click', function () {
                    construirDireccion();
                    geocodificarDireccionActual(true);
                });
            }

            // Botón de "Mi Ubicación Actual" (GPS) ubicado en el contenedor de dirección
            const btnUbicacionGPS = document.getElementById('btnUbicacionActualGPS') 
                                 || document.getElementById('btnUbicacionActualMapa') 
                                 || document.getElementById('btnUbicacionActualRural');
            if (btnUbicacionGPS) {
                btnUbicacionGPS.addEventListener('click', obtenerUbicacionActualGPS);
            }

            // E. Inputs del Horario de Atención
            document.querySelectorAll('.dia-horario-check').forEach(cb => {
                cb.addEventListener('change', construirHorario);
            });
            const inputHoraIni = document.getElementById('inputHoraInicio');
            const inputHoraFin = document.getElementById('inputHoraCierre');
            if (inputHoraIni) inputHoraIni.addEventListener('change', construirHorario);
            if (inputHoraFin) inputHoraFin.addEventListener('change', construirHorario);

            // F. Carga dinámica de Municipios al cambiar Departamento
            const selectDepto = document.getElementById('selectDepartamento');
            if (selectDepto) {
                selectDepto.addEventListener('change', function () {
                    const deptoId = this.value;
                    const selectMun = document.getElementById('selectMunicipio');
                    selectMun.innerHTML = '<option value="">Cargando municipios...</option>';

                    centrarMapa('departamento');

                    if (!deptoId) {
                        selectMun.innerHTML = '<option value="">-- Seleccione primero un departamento --</option>';
                        return;
                    }

                    fetch('@Url.Action("ObtenerMunicipios", "PuntoAcopio")?idDepartamento=' + deptoId)
                        .then(response => response.json())
                        .then(data => {
                            selectMun.innerHTML = '<option value="">-- Seleccione un municipio --</option>';
                            data.forEach(m => {
                                const opt = document.createElement('option');
                                opt.value = m.id;
                                opt.textContent = m.nombre;
                                selectMun.appendChild(opt);
                            });
                        })
                        .catch(() => {
                            selectMun.innerHTML = '<option value="">Error al cargar municipios</option>';
                        });
                });
            }

            const selectMun = document.getElementById('selectMunicipio');
            if (selectMun) {
                selectMun.addEventListener('change', function () {
                    centrarMapa('municipio');
                    // Solo si es zona urbana se geocodifica la dirección automáticamente al cambiar municipio
                    const zona = obtenerZonaSeleccionada();
                    const direccion = document.getElementById('inputDireccion')?.value;
                    if (zona === 'Urbano' && direccion) {
                        geocodificarDireccionActual(false);
                    }
                });
            }

            // G. Validación antes del envío del formulario (submit)
            const form = document.getElementById('formPuntoAcopio');
            if (form) {
                // Función auxiliar para desplazarse suavemente al elemento con error y enfocarlo
                function enfocarPrimerError(selector, mensaje) {
                    const el = document.querySelector(selector);
                    if (el) {
                        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        if (typeof el.focus === 'function') {
                            setTimeout(() => el.focus(), 400);
                        }
                    }
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Dato Requerido',
                            text: mensaje,
                            confirmButtonColor: '#2e7d32',
                            background: '#f8f9fa',
                            customClass: { popup: 'rounded-4 shadow-lg' }
                        });
                    } else {
                        alert(mensaje);
                    }
                }

                form.addEventListener('submit', function (e) {
                    const dir = construirDireccion();
                    const hor = construirHorario();
                    actualizarDescripcion();

                    // 1. Validación de Dirección generada (Urbano o Rural)
                    const zona = obtenerZonaSeleccionada();
                    if (zona === 'Rural') {
                        const inputVereda = document.getElementById('ruralNombreVereda');
                        if (!inputVereda || !inputVereda.value.trim()) {
                            e.preventDefault();
                            enfocarPrimerError('#ruralNombreVereda', 'Por favor ingrese el nombre de la vereda o sector rural donde opera el punto de acopio.');
                            return false;
                        }
                    } else {
                        const inputVia = document.getElementById('urbanoNumeroVia');
                        if (!inputVia || !inputVia.value.trim() || !dir || dir.trim() === '') {
                            e.preventDefault();
                            enfocarPrimerError('#urbanoNumeroVia', 'Por favor complete el número o nombre de la vía principal para generar la dirección.');
                            return false;
                        }
                    }

                    // 2. Validación de Teléfono (solo números, entre 7 y 10 dígitos)
                    const telInput = document.getElementById('Telefono');
                    const telVal = (telInput?.value || '').trim();
                    if (!telVal || !/^[0-9]{7,10}$/.test(telVal)) {
                        e.preventDefault();
                        enfocarPrimerError('#Telefono', 'El teléfono debe contener solo números y tener entre 7 y 10 dígitos (mínimo 7 para fijo o 10 para celular).');
                        return false;
                    }

                    // 3. Validación de Horario de atención generado
                    if (!hor || hor.trim() === '') {
                        e.preventDefault();
                        enfocarPrimerError('#cardHorarioAtencion', 'Por favor seleccione al menos un día hábil y las horas de inicio y cierre para el horario de atención.');
                        return false;
                    }

                    // 4. Validación de Coordenadas del Mapa (RN-01-CU018)
                    const lat = parseFloat(document.getElementById('latitudHidden').value);
                    const lng = parseFloat(document.getElementById('longitudHidden').value);
                    if (isNaN(lat) || isNaN(lng) || lat === 0 || lng === 0) {
                        e.preventDefault();
                        const mapDiv = document.getElementById('map');
                        if (mapDiv) {
                            mapDiv.style.border = '2px solid #dc3545';
                            mapDiv.style.borderRadius = '1rem';
                        }
                        enfocarPrimerError('#map', 'Debe fijar las coordenadas en el mapa interactivo (usando "Mi Ubicación Actual", ubicando la dirección o haciendo clic directamente sobre el mapa).');
                        return false;
                    }
                });
            }

            // H. Inicialización de valores al cargar la vista
            const dirActual = document.getElementById('inputDireccion')?.value || '';
            if (dirActual) {
                if (dirActual.toLowerCase().startsWith('vereda')) {
                    if (radioRural) {
                        radioRural.checked = true;
                        alternarZonaDireccion();
                    }
                    const nombreVereda = dirActual.replace(/^Vereda\s*/i, '');
                    if (ruralInput) ruralInput.value = nombreVereda;
                } else {
                    if (radioUrbano) {
                        radioUrbano.checked = true;
                        alternarZonaDireccion();
                    }
                }
            } else {
                alternarZonaDireccion();
            }

            // Inicializar concatenaciones visuales
            construirDireccion();
            construirHorario();
            actualizarDescripcion();

            // Auto-scroll al primer campo con error de validación (jQuery Validate o ModelState de C#)
            if (window.jQuery && $.validator) {
                $('#formPuntoAcopio').on('invalid-form.validate', function (event, validator) {
                    if (validator.errorList && validator.errorList.length > 0) {
                        const primerError = validator.errorList[0];
                        const elemento = $(primerError.element);
                        if (elemento.length > 0) {
                            $('html, body').animate({
                                scrollTop: elemento.offset().top - 120
                            }, 500);
                            setTimeout(() => elemento.focus(), 550);
                        }
                    }
                });
            }

            // Si la página se recargó tras envío con errores del servidor (ModelState)
            const primerSpanError = document.querySelector('.field-validation-error, .input-validation-error');
            if (primerSpanError) {
                primerSpanError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                const inputAsociado = primerSpanError.closest('.mb-3')?.querySelector('input, select, textarea');
                if (inputAsociado && typeof inputAsociado.focus === 'function') {
                    setTimeout(() => inputAsociado.focus(), 400);
                }
            }

            // I. Control de tiempo de alertas flotantes (FE-01, FE-02 Y ÉXITO)
            const alertaConexion = document.getElementById('alertaErrorConexion');
            if (alertaConexion) {
                setTimeout(() => {
                    alertaConexion.style.transition = 'opacity 0.8s ease';
                    alertaConexion.style.opacity = '0';
                    setTimeout(() => alertaConexion.remove(), 800);
                }, 6000);
            }

            const alertaDuplicado = document.getElementById('alertaErrorDuplicado');
            if (alertaDuplicado) {
                setTimeout(() => {
                    alertaDuplicado.style.transition = 'opacity 0.8s ease';
                    alertaDuplicado.style.opacity = '0';
                    setTimeout(() => alertaDuplicado.remove(), 800);
                }, 6000);
            }

            const alertaExito = document.getElementById('alertaExito');
            if (alertaExito) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Punto de Acopio Registrado!',
                        text: '@(ViewBag.MensajeExito ?? "Punto de acopio registrado satisfactoriamente.")',
                        timer: 3500,
                        timerProgressBar: true,
                        showConfirmButton: true,
                        confirmButtonText: 'Aceptar',
                        confirmButtonColor: '#2e7d32',
                        background: '#f8f9fa',
                        customClass: { popup: 'rounded-4 shadow-lg' }
                    }).then(() => {
                        window.location.href = '@Url.Action("Index", "Perfil")';
                    });
                } else {
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Index", "Perfil")';
                    }, 3000);
                }
            }
        });
    </script>
