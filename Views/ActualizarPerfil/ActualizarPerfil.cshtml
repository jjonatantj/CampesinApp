@model CampesinApp.ViewModels.ActualizarPerfilViewModel

@{
    ViewData["Title"] = "Actualizar Perfil - CampesinApp";
    Layout = "_LayoutCasosUso";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7 position-relative">

            <!-- LOGO -->
            <div class="text-center" style="position: relative; margin-bottom: -75px; z-index: 10;">
                <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo CampesinApp" width="150" height="150" class="rounded-circle shadow-lg border border-3 border-success bg-white" style="object-fit: cover;" />
            </div>

            <div class="card main-container border-0 shadow-lg p-4 p-md-5 pt-5 bg-white">

                <div class="text-center mb-4 mt-3">
                    <h2 class="fw-bold text-dark mb-1">Actualización de Datos de Perfil</h2>
                    <p class="text-muted small fw-semibold">Modifique su información personal y de contacto según sea necesario.</p>
                </div>

                <form asp-action="Guardar" method="post" id="formActualizarPerfil">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- CAMPOS DE SÓLO LECTURA -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Nombres</label>
                            <input asp-for="Nombres" class="form-control rounded-pill px-3 py-2 bg-light text-muted" readonly />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Apellidos</label>
                            <input asp-for="Apellidos" class="form-control rounded-pill px-3 py-2 bg-light text-muted" readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary small">Cédula</label>
                            <input asp-for="Cedula" class="form-control rounded-pill px-3 py-2 bg-light text-muted" readonly />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefono" class="form-label fw-bold text-dark small">Teléfono</label>
                            <input asp-for="Telefono" class="form-control rounded-pill px-3 py-2" placeholder="Teléfono" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-bold text-dark small">Correo Electrónico</label>
                        <input asp-for="Correo" class="form-control rounded-pill px-3 py-2" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <!-- UBICACIÓN -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-dark small">Departamento</label>
                            <select id="ddlDepartamento" asp-for="IdDepartamento" asp-items="Model.ListaDepartamentos" class="form-select rounded-pill px-3 py-2" onchange="cargarMunicipios()">
                                <option value="">Seleccione departamento...</option>
                            </select>
                            <span asp-validation-for="IdDepartamento" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-dark small">Municipio</label>
                            <select id="ddlMunicipio" asp-for="IdMunicipio" asp-items="Model.ListaMunicipios" class="form-select rounded-pill px-3 py-2">
                                <option value="">Seleccione municipio...</option>
                            </select>
                            <span asp-validation-for="IdMunicipio" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- CONTRASEÑA -->
                    <div class="mb-4">
                        <label asp-for="NuevaContrasena" class="form-label fw-bold text-dark small">Nueva Contraseña (Opcional)</label>
                        <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                            <input asp-for="NuevaContrasena" type="password" id="txtPasswordActualizar" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Dejar en blanco para mantener la actual" />
                            <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtPasswordActualizar', 'iconActualizarPass')">
                                <svg id="iconActualizarPass" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                    </div>

                    <!-- BOTONES DE ACCIÓN -->
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4 py-2">Salir</a>
                        <button type="button" onclick="confirmarActualizacion()" class="btn btn-success rounded-pill px-5 py-2 fw-bold" style="background-color: #2e7d32; border-color: #2e7d32;">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/MostrarContraseña.js" asp-append-version="true"></script>
    <script>
        // Alerta de éxito con temporizador de 5 segundos, botón OK y redirección automática
        @if (TempData["MensajeActualizacion"] != null)
            {
                <text>
                    let timerInterval;
                Swal.fire({
                    icon: 'success',
                    title: '¡Actualización Exitosa!',
                    html: 'Tus datos se han actualizado correctamente.<br><br>Serás redirigido en <b>5</b> segundos.',
                    timer: 5000,
                    timerProgressBar: true,
                    showConfirmButton: true,
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#198754',
                    background: '#f8f9fa',
                    customClass: { popup: 'rounded-4 shadow-lg' },
                    didOpen: () => {
                        const b = Swal.getHtmlContainer().querySelector('b');
                        timerInterval = setInterval(() => {
                            b.textContent = Math.ceil(Swal.getTimerLeft() / 1000);
                        }, 100);
                    },
                    willClose: () => {
                        clearInterval(timerInterval);
                    }
                }).then((result) => {
                    window.location.href = '@Url.Action("Index", "Perfil")';
                });
            </text>
        }

            function confirmarActualizacion() {
                Swal.fire({
                    title: '¿Está seguro de actualizar sus datos?',
                    text: "Se guardarán los cambios realizados en su perfil.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'SÍ, actualizar',
                    cancelButtonText: 'NO',
                    background: '#f8f9fa',
                    customClass: { popup: 'rounded-4 shadow-lg' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('formActualizarPerfil').submit();
                    }
                });
            }

        function cargarMunicipios() {
            var depId = $("#ddlDepartamento").val();
            var $ddlMuni = $("#ddlMunicipio");
            $ddlMuni.empty().append('<option value="">Cargando municipios...</option>');

            if (depId) {
                $.getJSON('/ActualizarPerfil/ObtenerMunicipiosPorDepartamento?idDepartamento=' + depId, function (data) {
                    $ddlMuni.empty().append('<option value="">Seleccione municipio...</option>');
                    $.each(data, function (i, item) {
                        $ddlMuni.append($('<option>', { value: item.id, text: item.nombre }));
                    });
                });
            } else {
                $ddlMuni.empty().append('<option value="">Seleccione municipio...</option>');
            }
        }
    </script>
}