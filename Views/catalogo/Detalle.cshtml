@model CampesinApp.ViewModels.DetalleDemandaViewModel

@{
    ViewData["Title"] = $"Detalle Demanda #{Model.IdDemanda} - {Model.NombreProducto}";
    // Asignación dinámica de Layout según el estado de autenticación (Invitado vs Usuario con sesión)
    Layout = Model.EsUsuarioAutenticado ? "_LayoutCasosUso" : "_Layout";
}

<!-- Contenedor principal estilizado con el diseño global (.main-container de site.css) -->
<div class="container main-container py-4 my-4">

    <!-- ============================================================== -->
    <!-- BARRA SUPERIOR: ENCABEZADO Y BOTÓN VOLVER (FA01-CU012)          -->
    <!-- ============================================================== -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-success fs-6">Demanda #@Model.IdDemanda</span>
                <span class="badge bg-secondary">@Model.EstadoDemanda</span>
                @if (Model.CantidadFaltante == 0)
                {
                    <span class="badge bg-info text-dark">Demanda Completada</span>
                }
            </div>
            <h1 class="brand-title mb-0">@Model.NombreProducto</h1>
            <p class="text-muted mb-0">Variedad: <strong class="text-dark">@Model.VariedadProducto</strong></p>
        </div>

        <!-- Botón Volver al catálogo (FA01-CU012) -->
        <div>
            <a asp-controller="catalogo" asp-action="Index" class="btn btn-outline-secondary px-3 shadow-sm">
                ← Volver al Catálogo
            </a>
        </div>
    </div>

    <!-- ============================================================== -->
    <!-- CONTENIDO PRINCIPAL: 2 COLUMNAS (INFO PRODUCTO & CONDICIONES)  -->
    <!-- ============================================================== -->
    <div class="row g-4">

        <!-- COLUMNA IZQUIERDA: Tarjeta Visual del Producto y Aportes -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <!-- Imagen representativa del producto -->
                <img src="~/images/logo.jpeg" 
                     alt="Imagen de @Model.NombreProducto" 
                     class="card-img-top rounded-top-3" 
                     style="height: 240px; object-fit: cover;" />

                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <h4 class="card-title text-success fw-bold mb-3">Requisitos de la Demanda</h4>
                        
                        <p class="text-secondary mb-3">
                            @(string.IsNullOrWhiteSpace(Model.Descripcion) ? "El comprador no ha incluido especificaciones adicionales." : Model.Descripcion)
                        </p>

                        <hr class="my-3 text-muted" />

                        <!-- Progreso de Aportes de Campesinos -->
                        <h6 class="fw-bold text-dark mb-2">Progreso de Aportes</h6>
                        <div class="progress mb-2" style="height: 22px;">
                            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated fw-bold" 
                                 role="progressbar" 
                                 style="width: @Model.PorcentajeCompletado%;" 
                                 aria-valuenow="@Model.PorcentajeCompletado" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                                @Model.PorcentajeCompletado%
                            </div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Aportado: <strong>@Model.CantidadAportada.ToString("N0") Kg</strong></span>
                            <span>Total: <strong>@Model.CantidadTotal.ToString("N0") Kg</strong></span>
                        </div>
                    </div>

                    <!-- Datos Rápidos del Comprador -->
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-muted d-block">Publicado por:</small>
                                <span class="fw-bold text-dark">@Model.CompradorNombreCompleto</span>
                            </div>
                            <!-- Botón Modal Ver Comprador (FA02-CU012) -->
                            <button type="button" 
                                    class="btn btn-outline-success btn-sm px-3 fw-semibold shadow-sm"
                                    data-bs-toggle="modal" 
                                    data-bs-target="#modalComprador">
                                👤 Ver Comprador
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: Cantidades, Precios, Logística y Ofertar -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white h-100 d-flex flex-column justify-content-between">

                <div>
                    <!-- Métricas Principales (Kilos y Precios) -->
                    <div class="row g-3 mb-4">
                        <!-- Cantidad Faltante (Destacada) -->
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 border-start border-4 border-warning shadow-sm">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1">Cantidad Faltante</small>
                                <div class="fs-2 fw-bold text-warning text-dark">
                                    @Model.CantidadFaltante.ToString("N0") <span class="fs-5 text-muted">Kg</span>
                                </div>
                                <small class="text-secondary">De un total de @Model.CantidadTotal.ToString("N0") Kg</small>
                            </div>
                        </div>

                        <!-- Precio Propuesto por Kilo -->
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 border-start border-4 border-success shadow-sm">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1">Precio Propuesto / Kg</small>
                                <div class="fs-2 fw-bold text-success">
                                    $@Model.PrecioPropuesto.ToString("N0")
                                </div>
                                <small class="text-secondary">Total estimado: $@((Model.CantidadTotal * Model.PrecioPropuesto).ToString("N0"))</small>
                            </div>
                        </div>
                    </div>

                    <!-- Detalles Logísticos y de Entrega -->
                    <h5 class="fw-bold text-dark mb-3">📍 Datos de Entrega y Logística</h5>
                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">Departamento y Municipio:</span>
                            <span class="fw-semibold text-dark">@Model.DepartamentoEntrega - @Model.MunicipioEntrega</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">Dirección de Entrega:</span>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.DireccionEntrega) ? "Punto de Acopio del Municipio" : Model.DireccionEntrega)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">Fecha Límite para Ofertar:</span>
                            <span class="fw-semibold text-danger">@Model.FechaLimite.ToString("dd/MM/yyyy")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">Fecha Estimada de Entrega:</span>
                            <span class="fw-semibold text-dark">@Model.FechaEntrega.ToString("dd/MM/yyyy")</span>
                        </li>
                    </ul>

                    <!-- Mensaje informativo para campesinos -->
                    <div class="alert alert-info py-2 px-3 small rounded-3 d-flex align-items-center gap-2 mb-4">
                        <span>💡</span>
                        <span>
                            Puedes responder aportando una cantidad parcial o total de los kilos faltantes hasta completar la demanda del comprador.
                        </span>
                    </div>
                </div>

                <!-- Botones de Acción (Ofertar CU-013 y Volver) -->
                <div class="pt-3 border-top d-flex flex-wrap gap-2 justify-content-end align-items-center">
                    <a asp-controller="catalogo" asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">
                        ← Regresar
                    </a>

                    @if (Model.CantidadFaltante <= 0)
                    {
                        <button class="btn btn-secondary px-4 fw-bold disabled" disabled>
                            Demanda Completa
                        </button>
                    }
                    else if (Model.EsUsuarioAutenticado)
                    {
                        <!-- Redirección al caso de uso CU-013: Ofertar / Registrar Aporte -->
                        <a href="@Url.Action("Registrar", "Oferta", new { idDemanda = Model.IdDemanda })" 
                           class="btn btn-success px-4 py-2 fw-bold shadow-sm">
                            🌾 Ofertar (CU-013)
                        </a>
                    }
                    else
                    {
                        <!-- Para usuarios invitados: invitar a iniciar sesión para poder ofertar -->
                        <a asp-controller="InicioSesion" asp-action="Login" 
                           class="btn btn-success px-4 py-2 fw-bold shadow-sm"
                           title="Debes iniciar sesión con tu cuenta de Campesino para responder">
                            🔑 Iniciar Sesión para Ofertar
                        </a>
                    }
                </div>

            </div>
        </div>

    </div>

</div>

<!-- ============================================================== -->
<!-- MODAL: DETALLES DEL COMPRADOR (FA02-CU012)                      -->
<!-- ============================================================== -->
<div class="modal fade" id="modalComprador" tabindex="-1" aria-labelledby="modalCompradorLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-3">
            
            <div class="modal-header bg-success text-white rounded-top-3">
                <h5 class="modal-title fw-bold" id="modalCompradorLabel">
                    👤 Información del Comprador
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <div class="avatar-circle mx-auto mb-2 bg-light text-success fw-bold d-flex align-items-center justify-content-center rounded-circle border shadow-sm" style="width: 70px; height: 70px; font-size: 1.8rem;">
                        @(string.IsNullOrEmpty(Model.CompradorNombreCompleto) ? "C" : Model.CompradorNombreCompleto.Substring(0, 1).ToUpper())
                    </div>
                    <h5 class="fw-bold mb-0">@Model.CompradorNombreCompleto</h5>
                    <small class="text-muted">Comprador Registrado</small>
                </div>

                <div class="list-group list-group-flush rounded-3">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-3">
                        <span class="text-muted">📍 Ubicación:</span>
                        <span class="fw-semibold text-dark">@Model.CompradorMunicipio</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-3">
                        <span class="text-muted">📞 Teléfono de Contacto:</span>
                        <span class="fw-semibold text-dark">@Model.CompradorTelefono</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-2 py-3">
                        <span class="text-muted">✉️ Correo Electrónico:</span>
                        <span class="fw-semibold text-dark">@Model.CompradorCorreo</span>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light rounded-bottom-3">
                <button type="button" class="btn btn-secondary px-4 fw-semibold" data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

