@model CampesinApp.ViewModels.ProcesoPagoViewModel

@{
    ViewData["Title"] = "Proceso de Pagos";
    Layout = "_LayoutCasosUso";
}

<!-- Librería de iconos Bootstrap integrada en el proyecto -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" integrity="sha384-Ay26V7L8bsJTsX9Sxclnvsn+hkdiwRnrjZJXqKmkIDobPgIIWBOVguEcQQLDuhfN" crossorigin="anonymous" />

<div class="container py-4 my-4">
    <div class="main-container p-4 p-md-5 rounded-4 shadow-sm bg-white mx-auto" style="max-width: 820px;">

        <!-- ============================================================== -->
        <!-- ENCABEZADO DE LA VISTA                                         -->
        <!-- ============================================================== -->
        <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
            <div class="p-3 rounded-circle me-3" style="background-color: #e8f5e9; color: #2e7d32;">
                <i class="bi bi-cash-coin fs-3"></i>
            </div>
            <div>
                <h1 class="brand-title mb-0 fs-2" style="color: #1b5e20;">Proceso de Pagos</h1>
                <p class="text-muted mb-0 fw-semibold">
                    Confirmación y custodia segura de fondos para la demanda de productos agrícolas.
                </p>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- ALERTA INFORMATIVA: PAGO PROTEGIDO                             -->
        <!-- ============================================================== -->
        <div class="alert alert-success shadow-sm border-0 rounded-4 d-flex align-items-center mb-4" style="background-color: #f1f8e9; color: #2e7d32;" role="alert">
            <i class="bi bi-shield-lock-fill fs-3 me-3 text-success"></i>
            <div class="flex-grow-1 small">
                <strong>Pago Protegido:</strong> El dinero se debita y permanece custodiado de forma segura en CampesinApp. Ningún desembolso se realiza al campesino ni al transportador hasta que la entrega física de la cosecha sea confirmada y recibida a total conformidad.
            </div>
        </div>

        <!-- Resumen de errores si existen -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger shadow-sm rounded-4 mb-4 border-0" id="alertaErrorPago" style="background-color: #fde8e8;">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-x-circle-fill text-danger fs-4 me-2"></i>
                    <h6 class="fw-bold text-danger mb-0">No fue posible completar la transacción:</h6>
                </div>
                <div asp-validation-summary="All" class="small mb-0 text-dark ps-4 fw-semibold"></div>
            </div>
        }

        <!-- ============================================================== -->
        <!-- TARJETA CON EL RESUMEN DEL PEDIDO A PAGAR                      -->
        <!-- ============================================================== -->
        <div class="card border rounded-4 shadow-sm p-4 mb-4 bg-white">
            <h5 class="fw-bold text-success mb-3 pb-2 border-bottom">
                <i class="bi bi-receipt me-1"></i> Resumen de la Orden @(Model.IdDemanda > 0 ? $"(Demanda #{Model.IdDemanda})" : "")
            </h5>

            <div class="row g-3">
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Producto y Variedad:</span>
                    <strong class="text-dark fs-6">@Model.NombreProducto - @Model.NombreVariedad</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted small d-block">Punto de Entrega:</span>
                    <strong class="text-dark fs-6">@Model.DireccionEntrega</strong>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Cantidad Requerida:</span>
                    <strong class="text-dark fs-6">@((Model.CantidadKilos ?? 0).ToString("N0")) Kg</strong>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Precio por Kilo:</span>
                    <strong class="text-dark fs-6">$@((Model.PrecioPorKilo ?? 0).ToString("N0")) COP</strong>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block">Fecha Estimada de Entrega:</span>
                    <strong class="text-dark fs-6">@(Model.FechaEntrega?.ToString("dd/MM/yyyy") ?? "")</strong>
                </div>
            </div>

            <!-- Total a Pagar destacado -->
            <div class="mt-4 p-3 rounded-4 border d-flex justify-content-between align-items-center" style="background-color: #f9fbf9;">
                <div>
                    <span class="fw-bold text-dark d-block">Valor Total a Pagar (100%):</span>
                    <small class="text-muted">Valor total retenido para aportes campesinos y logística</small>
                </div>
                <div class="text-end">
                    <span class="fs-3 fw-bold text-success" style="color: #1b5e20;">$@Model.ValorTotalPagar.ToString("N0") COP</span>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- FORMULARIO DE CONFIRMACIÓN DE PAGO                             -->
        <!-- ============================================================== -->
        <form asp-controller="ProcesoPago" asp-action="ConfirmarPago" method="post" id="formProcesoPago" novalidate autocomplete="off">
            @Html.AntiForgeryToken()

            <!-- Campos ocultos de la demanda -->
            <input type="hidden" asp-for="IdDemanda" />
            <input type="hidden" id="deviceSessionId" name="DeviceSessionId" />

            <div class="mb-4">
                <h5 class="fw-bold text-success mb-3 pb-2 border-bottom">
                    <i class="bi bi-credit-card me-1"></i> Selección del Medio de Pago
                </h5>

                <label asp-for="IdPerfilPagoSeleccionado" class="form-label fw-bold small text-dark">
                    Método de Pago Registrado *
                </label>
                <div class="input-group border rounded-pill bg-white overflow-hidden align-items-center shadow-none mb-1" id="groupSelectMetodoPago">
                    <span class="input-group-text bg-transparent border-0 text-success ps-3"><i class="bi bi-wallet2"></i></span>
                    <select asp-for="IdPerfilPagoSeleccionado" asp-items="Model.ListaMetodosPago" class="form-select border-0 shadow-none px-3 py-2 bg-transparent" id="selectMetodoPago" required>
                        <option value="">-- Selecciona el medio de pago para la transacción --</option>
                    </select>
                </div>
                <!-- Mensaje de error dinámico con estilo CampesinApp -->
                <div id="errorMetodoPagoRequerido" class="text-danger small ms-2 fw-semibold d-none mt-1">
                    <i class="bi bi-exclamation-circle-fill me-1"></i> Por favor selecciona un método de pago registrado para continuar.
                </div>
                <small class="text-muted ms-2 d-block mt-1">
                    ¿Deseas usar otra tarjeta o cuenta bancaria? Puedes agregarla en <a asp-controller="PerfilPago" asp-action="Index" class="text-success fw-semibold">Perfil de Pago</a>.
                </small>
                <span asp-validation-for="IdPerfilPagoSeleccionado" class="text-danger small ms-2 d-block"></span>
            </div>

            <!-- ============================================================== -->
            <!-- BOTONES DE ACCIÓN: Cancelar y Confirmar Pago                   -->
            <!-- ============================================================== -->
            <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top flex-wrap gap-2">
                <a asp-controller="ProcesoPago" asp-action="Cancelar" class="btn btn-secondary px-4 py-2 fw-semibold rounded-pill shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Cancelar
                </a>

                <button type="button" class="btn btn-success px-5 py-2 fw-bold rounded-pill text-white shadow-sm" id="btnConfirmarPago" style="background-color: #2e7d32; border-color: #2e7d32;">
                    <i class="bi bi-check-circle me-1"></i> Confirmar Pago
                </button>
            </div>
        </form>

    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL DE CONFIRMACIÓN DEL PAGO                                -->
<!-- ============================================================== -->
<div class="modal fade" id="modalConfirmarPagoModal" tabindex="-1" aria-labelledby="modalConfirmarPagoModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-header text-white" style="background-color: #2e7d32;">
                <h5 class="modal-title fw-bold" id="modalConfirmarPagoModalLabel">
                    <i class="bi bi-cash-stack me-2"></i>Confirmación de Transacción
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body p-4 bg-white">
                <p class="text-dark mb-3">
                    ¿Confirmas el débito y retención del 100% del pedido por un valor de:
                </p>
                <div class="p-3 bg-light rounded-3 text-center mb-3">
                    <span class="fs-4 fw-bold text-success">$@Model.ValorTotalPagar.ToString("N0") COP</span>
                </div>
                <p class="small text-muted mb-0">
                    <i class="bi bi-info-circle me-1"></i> El dinero quedará custodiado por CampesinApp hasta que el pedido sea entregado a conformidad.
                </p>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" id="btnEjecutarPagoFinal" class="btn btn-success rounded-pill px-4 fw-bold text-white" style="background-color: #2e7d32; border-color: #2e7d32;">
                    Pagar Ahora
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- MODAL DE PAGO EXITOSO CON TEMPORIZADOR DE 4 SEGUNDOS          -->
<!-- ============================================================== -->
<div class="modal fade" id="modalPagoExitoso" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalPagoExitosoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content text-center p-4 rounded-4 shadow border-0 bg-white position-relative">
            
            <!-- Botón X para cerrar y redirigir -->
            <button type="button" class="btn-close position-absolute top-0 end-0 m-3" aria-label="Cerrar" onclick="redirigirInicio()"></button>

            <div class="modal-body p-3">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle shadow-sm"
                         style="width: 85px; height: 85px; background-color: #e8f5e9; color: #2e7d32;">
                        <i class="bi bi-check-circle-fill" style="font-size: 3.2rem;"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-2" style="color: #1b5e20;" id="modalPagoExitosoLabel">¡Pago Exitoso!</h3>
                <p class="fs-6 text-dark fw-semibold mb-2">
                    @(ViewBag.MensajeExito ?? "Tu pago ha sido procesado y confirmado con éxito.")
                </p>
                <p class="small text-muted mb-3">
                    Tu solicitud ha sido publicada en el catálogo y los fondos han quedado custodiados de forma segura.
                </p>
                <div class="alert alert-light border rounded-pill d-inline-block px-4 py-2 text-muted small mb-4">
                    <i class="bi bi-clock me-1 text-success"></i> Redirigiendo al inicio en <strong id="contadorSegundosExito" class="text-success fs-6">4</strong> segundos...
                </div>
                <div>
                    <button type="button" class="btn btn-success rounded-pill px-5 py-2 fw-bold text-white shadow-sm d-inline-flex align-items-center justify-content-center gap-2" style="background-color: #2e7d32; border-color: #2e7d32;" onclick="redirigirInicio()">
                        <span>Aceptar</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Scripts oficiales de Openpay (Antifraude / Device Session ID) -->
    @if ((ViewBag.OpenpayPais ?? "CO") == "CO")
    {
        <script type="text/javascript" src="https://resources.openpay.co/openpay.v1.min.js"></script>
        <script type="text/javascript" src="https://resources.openpay.co/openpay-data.v1.min.js"></script>
    }
    else
    {
        <script type="text/javascript" src="https://js.openpay.mx/openpay.v1.min.js"></script>
        <script type="text/javascript" src="https://js.openpay.mx/openpay-data.v1.min.js"></script>
    }

    <script type="text/javascript">
        function redirigirInicio() {
            window.location.href = '@Url.Action("Index", "PantallaPrincipal")';
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Inicialización de Openpay para antifraude (Device Session ID)
            const merchantId = "@(ViewBag.OpenpayMerchantId ?? "")";
            const publicKey = "@(ViewBag.OpenpayPublicKey ?? "")";
            const isSandbox = @(ViewBag.OpenpaySandbox == true ? "true" : "false");

            function inicializarDeviceSession() {
                const inputDevice = document.getElementById("deviceSessionId");
                if (window.OpenPay && merchantId && publicKey) {
                    try {
                        OpenPay.setId(merchantId);
                        OpenPay.setApiKey(publicKey);
                        OpenPay.setSandboxMode(isSandbox);
                        const devSession = OpenPay.deviceData.setup("formProcesoPago", "deviceSessionId");
                        if (inputDevice && devSession) {
                            inputDevice.value = devSession;
                        }
                        console.log("Device session generado para pago seguro:", devSession);
                    } catch (e) {
                        console.warn("OpenPay deviceData setup:", e);
                    }
                }
            }

            inicializarDeviceSession();
            window.addEventListener("load", inicializarDeviceSession);

            // 1. Manejo del Modal de Pago Exitoso con temporizador de 4 segundos
            const esPagoExitoso = @(ViewBag.PagoExitoso == true ? "true" : "false");
            if (esPagoExitoso) {
                const modalExitoElem = document.getElementById("modalPagoExitoso");
                if (modalExitoElem && typeof bootstrap !== "undefined") {
                    const modalExito = new bootstrap.Modal(modalExitoElem);
                    modalExito.show();

                    let segundos = 4;
                    const contador = document.getElementById("contadorSegundosExito");
                    const intervalo = setInterval(function () {
                        segundos--;
                        if (contador) contador.textContent = segundos;
                        if (segundos <= 0) {
                            clearInterval(intervalo);
                            redirigirInicio();
                        }
                    }, 1000);
                }
            }

            // 2. Si ocurrió un error en el pago, enfocar suavemente la alerta para que no pase desapercibida
            const alertaError = document.getElementById("alertaErrorPago");
            if (alertaError) {
                alertaError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            // 3. Control del Modal de Confirmación previo a enviar el pago
            const btnConfirmarPago = document.getElementById("btnConfirmarPago");
            const btnEjecutarPagoFinal = document.getElementById("btnEjecutarPagoFinal");
            const selectMetodoPago = document.getElementById("selectMetodoPago");
            const groupSelectMetodoPago = document.getElementById("groupSelectMetodoPago");
            const errorMetodoPago = document.getElementById("errorMetodoPagoRequerido");
            const modalConfirmar = new bootstrap.Modal(document.getElementById("modalConfirmarPagoModal"));
            const form = document.getElementById("formProcesoPago");

            // Limpiar error al interactuar con el selector
            if (selectMetodoPago) {
                selectMetodoPago.addEventListener("change", function () {
                    if (this.value) {
                        if (groupSelectMetodoPago) groupSelectMetodoPago.classList.remove("border-danger");
                        if (errorMetodoPago) errorMetodoPago.classList.add("d-none");
                    }
                });
            }

            if (btnConfirmarPago) {
                btnConfirmarPago.addEventListener("click", function () {
                    if (!selectMetodoPago || !selectMetodoPago.value) {
                        // Validación visual integrada con la identidad de CampesinApp (sin alert nativo)
                        if (groupSelectMetodoPago) {
                            groupSelectMetodoPago.classList.add("border-danger");
                        }
                        if (errorMetodoPago) {
                            errorMetodoPago.classList.remove("d-none");
                        }
                        if (selectMetodoPago) {
                            selectMetodoPago.focus();
                            selectMetodoPago.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                        return;
                    }
                    modalConfirmar.show();
                });
            }

            if (btnEjecutarPagoFinal) {
                btnEjecutarPagoFinal.addEventListener("click", function () {
                    btnEjecutarPagoFinal.disabled = true;
                    btnEjecutarPagoFinal.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Procesando pago seguro...';
                    inicializarDeviceSession();
                    form.submit();
                });
            }
        });
    </script>
}

