@model PerfilPublicoDto
@{
    ViewData["Title"] = "Perfil de " + Model.Rol.ToLowerInvariant();
    var iniciales = string.Concat(Model.NombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}

<div class="container pb-4">
    <div class="main-container p-4 p-md-5 shadow-sm mx-auto" style="max-width: 46rem;">
        <div class="text-center mb-4">
            @if (!string.IsNullOrEmpty(Model.FotoUrl))
            {
                <img src="@Model.FotoUrl" alt="Foto de @Model.NombreCompleto" width="120" height="120" class="rounded-circle border border-3 border-success shadow-sm mb-3" style="object-fit: cover;" />
            }
            else
            {
                <div class="rounded-circle border border-3 border-success shadow-sm mb-3 mx-auto d-flex align-items-center justify-content-center fw-bold bg-white" style="width: 120px; height: 120px; font-size: 2.4rem; color: #2e7d32;" aria-hidden="true">@iniciales</div>
            }
            <h1 class="brand-title fs-2 mb-1" style="color: #1b5e20;">@Model.NombreCompleto</h1>
            <span class="badge bg-success text-white px-3 py-2 rounded-pill">@Model.Rol</span>
            <p class="text-muted mt-2 mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.Ubicacion</p>
        </div>

        <h2 class="h6 text-uppercase text-secondary fw-bold">Reputación</h2>
        @if (Model.PromedioEstrellas == null)
        {
            <p class="text-muted">Aún no tiene calificaciones.</p>
        }
        else
        {
            <p class="mb-2">
                <span class="fs-4 fw-bold" style="color: #1b5e20;">@Model.PromedioEstrellas.Value.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("es-CO"))</span>
                <span class="text-warning" aria-hidden="true">@string.Concat(Enumerable.Repeat("★", (int)Math.Round(Model.PromedioEstrellas.Value)))</span>
                <span class="text-muted small">(@Model.TotalCalificaciones calificaciones)</span>
            </p>
            @if (Model.Comentarios.Count > 0)
            {
                <ul class="list-unstyled small mb-0">
                    @foreach (var comentario in Model.Comentarios)
                    {
                        <li class="border-top py-2">“@comentario”</li>
                    }
                </ul>
            }
        }

        <div class="mt-4">
            <a asp-controller="PantallaPrincipal" asp-action="Index" class="btn btn-nav-login text-decoration-none">Volver</a>
        </div>
    </div>
</div>
