@model PerfilDto
@{
    ViewData["Title"] = "Perfil de Usuario";

    string Clase(OpcionPerfilDto opcion) => opcion.Estilo switch
    {
        "principal" => "btn btn-nav-register",
        "peligro" => "btn btn-outline-danger rounded-pill",
        _ => "btn btn-nav-login"
    };
}

@* CU-031: tarjeta con los datos del usuario a la izquierda y, al costado derecho, los botones generales y los del rol. *@
<div class="container pb-4">
    <div class="main-container p-4 p-md-5 shadow-sm">
        <div class="d-flex align-items-center mb-4">
            <div class="p-3 rounded-circle me-3" style="background-color: #e8f5e9; color: #2e7d32;">
                <i class="bi bi-person-gear fs-3"></i>
            </div>
            <div>
                <h1 class="brand-title mb-0 fs-2" style="color: #1b5e20;">Perfil de Usuario</h1>
                <p class="text-muted mb-0 fw-semibold">Configuración y gestión de tu cuenta</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="feature-card h-100 text-center">
                    @if (!string.IsNullOrEmpty(Model.FotoUrl))
                    {
                        <img src="@Model.FotoUrl" alt="Foto de @Model.Nombres" width="130" height="130" class="rounded-circle border border-3 border-success shadow-sm mb-3" style="object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle border border-3 border-success shadow-sm mb-3 mx-auto d-flex align-items-center justify-content-center fw-bold bg-white" style="width: 130px; height: 130px; font-size: 2.6rem; color: #2e7d32;" aria-hidden="true">@Model.Iniciales</div>
                    }
                    <h2 class="h4 fw-bold text-dark mb-1">@Model.Nombres @Model.Apellidos</h2>
                    <span class="badge bg-success text-white px-3 py-2 rounded-pill mb-3">@Model.Rol</span>

                    <dl class="text-start mb-0 small">
                        <div class="d-flex justify-content-between border-top py-2"><dt class="text-muted fw-semibold">Correo</dt><dd class="mb-0 text-break text-end">@Model.Correo</dd></div>
                        <div class="d-flex justify-content-between border-top py-2"><dt class="text-muted fw-semibold">Teléfono</dt><dd class="mb-0">@Model.Telefono</dd></div>
                        <div class="d-flex justify-content-between border-top py-2"><dt class="text-muted fw-semibold">Identificación</dt><dd class="mb-0">@Model.Cedula</dd></div>
                        @if (!string.IsNullOrEmpty(Model.Municipio))
                        {
                            <div class="d-flex justify-content-between border-top py-2"><dt class="text-muted fw-semibold">Municipio</dt><dd class="mb-0">@Model.Municipio</dd></div>
                        }
                    </dl>
                </div>
            </div>

            <div class="col-lg-7">
                <h2 class="h6 text-uppercase text-secondary fw-bold mb-2">Mi cuenta</h2>
                <div class="d-flex flex-wrap gap-2 mb-4" role="group" aria-label="Opciones generales">
                    @foreach (var opcion in Model.OpcionesGenerales)
                    {
                        @Boton(opcion, Clase(opcion))
                    }
                </div>

                <h2 class="h6 text-uppercase text-secondary fw-bold mb-2">Opciones de @Model.Rol.ToLowerInvariant()</h2>
                <div class="d-flex flex-wrap gap-2" role="group" aria-label="Opciones del rol">
                    @foreach (var opcion in Model.OpcionesRol)
                    {
                        @Boton(opcion, Clase(opcion))
                    }
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <a asp-controller="PantallaPrincipal" asp-action="Index" class="btn btn-nav-register text-decoration-none px-4">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>
</div>

@functions {
    // Cada botón abre una ventana emergente, navega a una página o, si su módulo aún no existe, avisa que no está disponible.
    Microsoft.AspNetCore.Html.IHtmlContent Boton(OpcionPerfilDto opcion, string clase)
    {
        var icono = $"<i class=\"bi {opcion.Icono} me-1\"></i>";
        string html;
        if (opcion.UrlPagina != null)
        {
            html = $"<a class=\"{clase} text-decoration-none\" href=\"{System.Net.WebUtility.HtmlEncode(opcion.UrlPagina)}\">{icono}{System.Net.WebUtility.HtmlEncode(opcion.Texto)}</a>";
        }
        else
        {
            var destino = opcion.UrlModal ?? "/Perfil/Proximamente?opcion=" + Uri.EscapeDataString(opcion.Texto);
            html = $"<button type=\"button\" class=\"{clase}\" data-modal-url=\"{System.Net.WebUtility.HtmlEncode(destino)}\">{icono}{System.Net.WebUtility.HtmlEncode(opcion.Texto)}</button>";
        }
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}
