@{
    ViewData["Title"] = "Página no encontrada";
}

<div class="container text-center mt-5">
    <div class="card shadow-sm p-5 border-0 rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-body">
            <h1 class="display-4 text-warning fw-bold mb-3">¡Vaya! Algo salió mal</h1>
            <p class="lead text-muted">
                @ViewData["ErrorMessage"]
            </p>
            <hr class="my-4">
            <p class="text-secondary small">Verifica la dirección o regresa al inicio para continuar navegando.</p>

            <!-- ENLACE REDIRIGIDO A LA PÁGINA DE BIENVENIDA -->
            <a href="@Url.Action("Bienvenida", "PaginaBienvenida")" class="btn btn-success px-4 py-2 rounded-pill fw-semibold">
                Volver al Inicio
            </a>
        </div>
    </div>
</div>
