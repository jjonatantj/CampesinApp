@* Casos de uso 21-30: ventanas emergentes y scripts. Va al final del <body>, después de bootstrap.bundle.js.
   - #modalPrincipal: formularios y listas.  - #modalSuperpuesta: detalles, avisos y confirmaciones que van encima. *@
@inject IUsuarioActualService UsuarioActual
@{
    var usuario = await UsuarioActual.ObtenerAsync();
}
<div id="cu-contexto" class="d-none" data-autenticado="@(usuario != null ? "1" : "0")" data-rol="@usuario?.Rol" data-usuario="@usuario?.Id" data-inactividad-minutos="@SesionOpciones.MinutosInactividad"></div>

<div class="modal fade" id="modalPrincipal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content"></div>
    </div>
</div>
<div class="modal fade" id="modalSuperpuesta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content"></div>
    </div>
</div>

<script src="~/js/modales.js" asp-append-version="true"></script>
<script src="~/js/notificaciones.js" asp-append-version="true"></script>
<script src="~/js/inactividad.js" asp-append-version="true"></script>
<script src="~/js/mapas.js" asp-append-version="true"></script>
