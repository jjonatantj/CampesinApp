@model string
@{
    Layout = "_LayoutCasosUso";
    ViewData["Title"] = "No se pudo cargar";
}

<div class="container py-4">
    <div class="main-container p-5 text-center shadow-sm mx-auto" style="max-width: 36rem;" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-1 text-warning d-block mb-3"></i>
        <p class="fw-bold fs-5">@Model</p>
        <a asp-controller="Perfil" asp-action="Index" class="btn btn-dark px-4">Regresar al perfil</a>
    </div>
</div>
