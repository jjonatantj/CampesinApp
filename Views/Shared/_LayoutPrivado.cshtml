<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampesinApp</title>

    <!-- Bootstrap 5 CSS & Iconos -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <!-- Fuente Mulish y Hoja de Estilos CSS del proyecto -->
    <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- CU-021 a CU-032: token CSRF y estilos de las ventanas emergentes -->
    <partial name="_CasosUsoHead" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- CONTENIDO PRINCIPAL DE LA VISTA -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

   <!-- PIE DE PÁGINA -->
    <footer class="footer-modern mt-5 border-top py-4 bg-white text-muted">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo CampesinApp" width="28" height="28" class="rounded-circle" />
                        <span class="fw-bold text-dark fs-6">CampesinApp</span>
                    </div>
                    <small class="d-block text-secondary">
                        Conectando el Campo Colombiano con la Ciudad sin Intermediarios.
                    </small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <small class="text-secondary">
                        &copy; 2026 - CampesinApp &bull; Todos los derechos reservados &bull;
                        <a href="#contacto-soporte" class="text-decoration-none text-success fw-bold">Canales de Soporte</a>
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- CU-021 a CU-032: ventanas emergentes (modales), notificaciones y control de inactividad -->
    <partial name="_CasosUsoModales" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>