@model CampesinApp.ViewModels.ForzarCambioViewModel

@{
    ViewData["Title"] = "Actualizar Contraseña - CampesinApp";
    Layout = "_LayoutCasosUso";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 position-relative">

            <!-- LOGO SUPERPUESTO -->
            <div class="text-center" style="position: relative; margin-bottom: -75px; z-index: 10;">
                <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo CampesinApp" width="150" height="150" class="rounded-circle shadow-lg border border-3 border-success bg-white" style="object-fit: cover;" />
            </div>

            <div class="card main-container border-0 shadow-lg p-4 p-md-5 pt-5 text-center">
                <div class="mb-4 mt-3">
                    <h2 class="brand-title mb-1">Primer Inicio de Sesión</h2>
                    <p class="text-muted small">Por seguridad, debe actualizar su contraseña temporal</p>
                </div>

                <form asp-action="ForzarCambioContrasena" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <!-- NUEVA CONTRASEÑA CON "OJITO" -->
                    <div class="mb-3 text-start">
                        <label asp-for="NuevaContrasena" class="form-label fw-bold text-dark small"></label>
                        <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                            <input asp-for="NuevaContrasena" type="password" id="txtNewPass" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Nueva contraseña" />
                            <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtNewPass', 'iconNew')">
                                <svg id="iconNew" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                    </div>

                    <!-- CONFIRMAR CONTRASEÑA CON "OJITO" -->
                    <div class="mb-4 text-start">
                        <label asp-for="ConfirmarContrasena" class="form-label fw-bold text-dark small"></label>
                        <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                            <input asp-for="ConfirmarContrasena" type="password" id="txtConfirmPass" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Confirmar contraseña" />
                            <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtConfirmPass', 'iconConfirm')">
                                <svg id="iconConfirm" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-nav-register py-2 d-flex justify-content-center align-items-center w-100" style="font-size: 1rem;">Actualizar Contraseña</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/MostrarContraseña.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25" integrity="sha384-nLoOnA/BDh8A/jxqtckg4DumuCGOBYUnNJLZdQz/zfYNp3wcjGSoWTAzgko06G/2" crossorigin="anonymous"></script>

    @if (ViewBag.PasswordActualizado != null && (bool)ViewBag.PasswordActualizado)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                let timerInterval;
                Swal.fire({
                    icon: 'success',
                    title: '¡Contraseña actualizada con éxito!',
                    html: 'Serás redirigido al inicio de sesión en <b>4</b> segundos.',
                    timer: 4000,
                    timerProgressBar: true,
                    showConfirmButton: true,
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#198754',
                    background: '#f8f9fa',
                    customClass: { popup: 'rounded-4 shadow-lg' },
                    didOpen: () => {
                        const b = Swal.getHtmlContainer().querySelector('b');
                        timerInterval = setInterval(() => {
                            b.textContent = Math.ceil(Swal.getTimerLeft() / 1000);
                        }, 1000);
                    },
                    willClose: () => {
                        clearInterval(timerInterval);
                    }
                }).then((result) => {
                    window.location.href = '@Url.Action("Login", "InicioSesion")';
                });
            });
        </script>
    }
}