@model CampesinApp.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión - CampesinApp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 position-relative">
            
            <!-- LOGO -->
            <div class="text-center" style="position: relative; margin-bottom: -75px; z-index: 10;">
                <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo CampesinApp" width="150" height="150" class="rounded-circle shadow-lg border border-3 border-success bg-white" style="object-fit: cover;" />
            </div>

            <div class="card main-container border-0 shadow-lg p-4 p-md-5 pt-5">
                <div class="text-center mb-4 mt-3">
                    <h2 class="brand-title mb-1">Iniciar Sesión</h2>
                    <p class="text-muted" style="font-weight: 500;">Accede a tu cuenta con tu número de cédula</p>
                </div>

                <!-- FORMULARIO VINCULADO A INICIOSESIONCONTROLLER -->
                <form asp-controller="InicioSesion" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small text-center"></div>

                    <!-- CÉDULA -->
                    <div class="mb-3">
                        <label asp-for="Cedula" class="form-label fw-bold text-dark small"></label>
                        <input asp-for="Cedula" class="form-control rounded-pill px-3 py-2" placeholder="Número de cédula" autocomplete="off" />
                        <span asp-validation-for="Cedula" class="text-danger small"></span>
                    </div>

                    <!-- CONTRASEÑA -->
                    <div class="mb-4">
                        <label asp-for="Contrasena" class="form-label fw-bold text-dark small"></label>
                        <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                            <input asp-for="Contrasena" type="password" id="txtPasswordLogin" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Contraseña" />
                            <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtPasswordLogin', 'iconLoginPass')">
                                <svg id="iconLoginPass" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

                    <!-- ENLACE ¿OLVIDÓ SU CONTRASEÑA? -->
                    <div class="d-flex justify-content-end mb-4 small">
                        <a asp-controller="InicioSesion" asp-action="RecuperarPassword" class="text-success text-decoration-none fw-bold">¿Olvidó su contraseña?</a>
                    </div>

                    <!-- BOTÓN DE INICIO DE SESIÓN -->
                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-nav-register py-2 d-flex justify-content-center align-items-center w-100" style="font-size: 1rem;">
                            Iniciar Sesión
                        </button>
                    </div>
                </form>

                <div class="text-center mt-3 small">
                    <span class="text-muted">¿Aún no tiene una cuenta?</span>
                    <a asp-controller="RegistroUsuario" asp-action="Index" class="text-success fw-bold text-decoration-none ms-1">Regístrese aquí</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/MostrarContraseña.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}