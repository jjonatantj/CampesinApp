@model CampesinApp.ViewModels.RecuperaciónContraseñaViewModel

@{
    ViewData["Title"] = "Recuperación de Contraseña - CampesinApp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 position-relative">
            
            <!-- LOGO SUPERPUESTO -->
            <div class="text-center" style="position: relative; margin-bottom: -75px; z-index: 10;">
                <img src="@Url.Content("~/images/logo.jpeg")" alt="Logo CampesinApp" width="150" height="150" class="rounded-circle shadow-lg border border-3 border-success bg-white" style="object-fit: cover;" />
            </div>

            <div class="card main-container border-0 shadow-lg p-4 p-md-5 pt-5 text-center">
                <div class="mb-4 mt-3">
                    <h2 class="brand-title mb-1">Recuperación</h2>
                    <p class="text-muted small">Restablezca su contraseña de acceso</p>
                </div>

                <form asp-action="RecuperarPassword" method="post" id="formRecuperacion">
                    <input type="hidden" asp-for="Paso" />
                    <input type="hidden" asp-for="CorreoEnmascarado" />
                    <input type="hidden" asp-for="TelefonoEnmascarado" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <!-- PASO 1: Ingresar Cédula -->
                    @if (Model.Paso == 1)
                    {
                        <div class="mb-3 text-start">
                            <label asp-for="Cedula" class="form-label fw-bold text-dark small"></label>
                            <input asp-for="Cedula" class="form-control rounded-pill px-3 py-2" placeholder="Número de cédula" autocomplete="off" />
                            <span asp-validation-for="Cedula" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-nav-register py-2 d-flex justify-content-center align-items-center w-100" style="font-size: 1rem;">Continuar</button>
                        </div>
                    }

                    <!-- PASO 2: Seleccionar Método de Verificación -->
                    @if (Model.Paso == 2)
                    {
                        <input type="hidden" asp-for="Cedula" />
                        <p class="text-muted small mb-3">Seleccione el método para recibir el código de verificación:</p>
                        
                        <div class="mb-3 text-start">
                            <div class="form-check p-3 border rounded-pill mb-2 bg-white">
                                <input class="form-check-input ms-1" type="radio" name="MetodoSeleccionado" id="metodoCorreo" value="correo" checked />
                                <label class="form-check-label fw-bold text-dark ms-2" for="metodoCorreo">
                                    Correo: <span class="text-muted fw-normal">@Model.CorreoEnmascarado</span>
                                </label>
                            </div>
                            <div class="form-check p-3 border rounded-pill bg-white">
                                <input class="form-check-input ms-1" type="radio" name="MetodoSeleccionado" id="metodoTelefono" value="telefono" />
                                <label class="form-check-label fw-bold text-dark ms-2" for="metodoTelefono">
                                    Teléfono: <span class="text-muted fw-normal">@Model.TelefonoEnmascarado</span>
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-nav-register py-2 d-flex justify-content-center align-items-center w-100" style="font-size: 1rem;">Continuar</button>
                        </div>
                    }

                    <!-- PASO 3: Ingresar Código de 6 Dígitos con Temporizador -->
                    @if (Model.Paso == 3)
                    {
                        <input type="hidden" asp-for="Cedula" />
                        <input type="hidden" asp-for="MetodoSeleccionado" />
                        
                        <p class="text-muted small mb-1">Hemos enviado un código de 6 dígitos a su medio seleccionado.</p>

                        <!-- TEMPORIZADOR REGRESIVO -->
                        <div id="temporizadorContainer" class="mt-2 mb-3">
                            <span class="fw-bold" style="color: #1d4ed8; font-size: 0.90rem;">
                                El código expira en <span id="tiempoRestante">04:59</span>
                            </span>
                        </div>

                        <div class="mb-3 text-start">
                            <label asp-for="CodigoVerificacion" class="form-label fw-bold text-dark small"></label>
                            <input asp-for="CodigoVerificacion" id="txtCodigoVerificacion" class="form-control text-center rounded-pill py-2" placeholder="000000" maxlength="6" autocomplete="off" />
                            <span asp-validation-for="CodigoVerificacion" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" id="btnVerificar" class="btn btn-nav-register py-2 d-flex justify-content-center align-items-center w-100" style="font-size: 1rem;">Verificar Código</button>
                        </div>

                        <div class="d-flex justify-content-between small mt-2">
                            <a href="#" class="text-muted text-decoration-none">Reenviar código</a>
                            <a asp-action="RecuperarPassword" class="text-success text-decoration-none fw-bold">Cambiar método</a>
                        </div>
                    }

                    <!-- PASO 4: Ingresar Nueva Contraseña -->
                    @if (Model.Paso == 4)
                    {
                        <input type="hidden" asp-for="Cedula" />
                        
                        <div class="mb-3 text-start">
                            <label asp-for="NuevaContrasena" class="form-label fw-bold text-dark small"></label>
                            <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                                <input asp-for="NuevaContrasena" type="password" id="txtNewPass" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Ingrese contraseña" />
                                <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtNewPass', 'iconNew')">
                                    <svg id="iconNew" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 text-start">
                            <label asp-for="ConfirmarContrasena" class="form-label fw-bold text-dark small"></label>
                            <div class="input-group input-group-pill border rounded-pill bg-white overflow-hidden align-items-center" style="border-color: #dee2e6 !important;">
                                <input asp-for="ConfirmarContrasena" type="password" id="txtConfirmPass" class="form-control border-0 shadow-none px-3 py-2 bg-transparent" style="appearance: none; -webkit-appearance: none;" placeholder="Confirmar contraseña" />
                                <button class="btn border-0 bg-transparent px-3 text-dark shadow-none" type="button" onclick="mostrarContrasena('txtConfirmPass', 'iconConfirm')">
                                    <svg id="iconConfirm" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#212529" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-nav-register py-2 d-flex justify-content-center align-items-center w-100" style="font-size: 1rem;">Cambiar Contraseña</button>
                        </div>
                    }
                </form>

                <div class="text-center mt-3 small">
                    <a asp-action="Login" class="text-success fw-bold text-decoration-none">Volver a Iniciar Sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/MostrarContraseña.js" asp-append-version="true"></script>
    <script src="~/js/VerificacionRecuperacionContraseña.js" asp-append-version="true"></script>
}
