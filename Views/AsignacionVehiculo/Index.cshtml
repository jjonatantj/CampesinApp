@model CampesinApp.ViewModels.CargasPendientesViewModel

@{
    ViewData["Title"] = "Cargas Pendientes - CU-020";
    Layout = "_LayoutCasosUso";
}

<!-- Notificación temporal flotante de 4 segundos (Paso 8 del CU-020: Asignación completa) -->
@if (TempData["MensajeExito"] != null)
{
    <div id="toastExitoCU020" class="alert alert-success alert-dismissible fade show shadow-lg position-fixed top-0 start-50 translate-middle-x mt-4 py-3 px-4" 
         role="alert" style="z-index: 1090; min-width: 320px; border-radius: 12px; border-left: 6px solid #1b5e20;">
        <div class="d-flex align-items-center">
            <span class="fs-3 me-2">✅</span>
            <div>
                <strong class="d-block fs-6 text-success">¡Operación Exitosa!</strong>
                <span class="fs-6 fw-semibold text-dark">@TempData["MensajeExito"]</span>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>

    <script>
        // Cierre automático tras exactamente 4 segundos según especificación del CU-020
        setTimeout(function () {
            var alerta = document.getElementById('toastExitoCU020');
            if (alerta) {
                alerta.classList.remove('show');
                setTimeout(() => alerta.remove(), 400);
            }
        }, 4000);
    </script>
}

<!-- Contenedor principal con estilo global traslúcido (.main-container de site.css) -->
<div class="container main-container py-4 my-4">

    <!-- ============================================================== -->
    <!-- PARTE SUPERIOR: BOTÓN "SALIR" GRIS (FA01-CU020) Y TÍTULO       -->
    <!-- ============================================================== -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
        
        <!-- Botón Salir gris en la parte superior izquierda (Paso 2 / FA01-CU020 hacia Perfil CU-031) -->
        <div>
            <a asp-controller="Perfil" asp-action="Index" class="btn btn-secondary px-4 fw-semibold shadow-sm">
                ← Salir
            </a>
        </div>

        <div class="text-end">
            <span class="badge bg-success px-3 py-2 fs-6 rounded-pill">Caso de Uso: CU-020</span>
        </div>
    </div>

    <!-- Título centrado descriptivo -->
    <div class="text-center mb-4">
        <h1 class="brand-title mb-1">Cargas Pendientes de Transporte</h1>
        <p class="text-muted fw-semibold">
            Selecciona un pedido de la lista para inspeccionar sus detalles y asignarle un conductor con camión disponible.
        </p>
    </div>

    <!-- Alerta de excepción o advertencia si aplica -->
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">⚠️</span>
                <div>
                    <strong>Atención:</strong> @TempData["MensajeError"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- ============================================================== -->
    <!-- PARTE CENTRAL: LISTA DE CARGAS PENDIENTES (Paso 2 del CU-020)  -->
    <!-- ============================================================== -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3 p-md-4">
        @if (Model.Cargas != null && Model.Cargas.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th scope="col" class="py-3 text-center" style="width: 140px;">ID Demanda</th>
                            <th scope="col" class="py-3">Producto Requerido</th>
                            <th scope="col" class="py-3 text-center">Cantidad</th>
                            <th scope="col" class="py-3">Destino</th>
                            <th scope="col" class="py-3 text-center">Fecha Entrega</th>
                            <th scope="col" class="py-3">Comprador</th>
                            <th scope="col" class="py-3 text-center" style="width: 130px;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var carga in Model.Cargas)
                        {
                            <tr>
                                <!-- ID de la demanda como hipervínculo (Paso 2) -->
                                <td class="text-center">
                                    <a asp-action="Detalle" asp-route-id="@carga.IdDemanda" 
                                       class="badge bg-primary text-decoration-none px-3 py-2 fs-6 shadow-sm"
                                       title="Ver detalle del pedido #@carga.IdDemanda">
                                        #@carga.IdDemanda
                                    </a>
                                </td>

                                <!-- Nombre del producto como hipervínculo (Paso 2) -->
                                <td>
                                    <a asp-action="Detalle" asp-route-id="@carga.IdDemanda" 
                                       class="text-decoration-none fw-bold text-success fs-6"
                                       title="Ver detalle de @carga.NombreProducto">
                                        @carga.NombreProducto
                                    </a>
                                    <small class="d-block text-muted">Variedad: @carga.Variedad</small>
                                </td>

                                <!-- Cantidad demandada en Kilos -->
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-3 py-2 fw-bold">
                                        @carga.CantidadKg.ToString("N0") Kg
                                    </span>
                                </td>

                                <!-- Destino -->
                                <td>
                                    <small class="text-secondary fw-semibold">
                                        <i class="bi bi-geo-alt text-danger me-1"></i>@carga.LugarDestino
                                    </small>
                                </td>

                                <!-- Fecha límite de entrega -->
                                <td class="text-center text-muted fw-semibold">
                                    @carga.FechaEntrega.ToString("dd/MM/yyyy")
                                </td>

                                <!-- Comprador -->
                                <td>
                                    <span class="fw-semibold text-dark">@carga.NombreComprador</span>
                                </td>

                                <!-- Botón selector -->
                                <td class="text-center">
                                    <a asp-action="Detalle" asp-route-id="@carga.IdDemanda" 
                                       class="btn btn-outline-success btn-sm px-3 fw-semibold shadow-sm">
                                        Seleccionar →
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- Estado vacío cuando no hay cargas pendientes de camión -->
            <div class="text-center py-5">
                <div class="mb-3">
                    <span class="fs-1 text-muted">🚛</span>
                </div>
                <h4 class="fw-bold text-dark mb-2">No hay cargas pendientes de transporte</h4>
                <p class="text-muted mb-4">Todas las demandas actuales ya tienen un vehículo asignado o no se encuentran disponibles.</p>
                <a asp-controller="Perfil" asp-action="Index" class="btn btn-secondary px-4 fw-semibold">
                    ← Regresar al Perfil
                </a>
            </div>
        }
    </div>

</div>

