@model CampesinApp.ViewModels.DetalleAsignacionViewModel

@{
    ViewData["Title"] = $"Detalle Pedido #{Model.IdDemanda} - Asignación de Transporte";
    Layout = "_LayoutCasosUso";
}

<!-- Librería de iconos Bootstrap integrada en el aplicativo -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" integrity="sha384-Ay26V7L8bsJTsX9Sxclnvsn+hkdiwRnrjZJXqKmkIDobPgIIWBOVguEcQQLDuhfN" crossorigin="anonymous" />

<div class="container main-container py-4 my-4 rounded-4">

    <!-- ============================================================== -->
    <!-- PARTE SUPERIOR: BOTÓN "REGRESAR" GRIS Y ENCABEZADO LIMPIO      -->
    <!-- ============================================================== -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <!-- Botón Regresar hacia el listado de cargas pendientes -->
            <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Regresar
            </a>
        </div>
        <div class="text-end">
            <span class="badge bg-success rounded-pill px-3 py-2 fs-6">
                Asignación de Transporte
            </span>
        </div>
    </div>

    <!-- Alertas de excepción (FE01-CU020: camión sin espacio o no disponible) -->
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4 mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-4 me-3"></i>
                <div>
                    <strong>Aviso:</strong> @TempData["MensajeError"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- ============================================================== -->
    <!-- INFORMACIÓN DEL PEDIDO EN LA PARTE SUPERIOR Y CENTRADA         -->
    <!-- ============================================================== -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <div class="text-center mb-4">
            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6 mb-2">Pedido #@Model.IdDemanda</span>
            <h2 class="brand-title mb-1 text-center">@Model.NombreProducto (@Model.Variedad)</h2>
            <p class="text-muted fw-semibold mb-0">Detalles de logística y cosecha esperando transporte</p>
        </div>

        <!-- Fila de métricas centradas: Origen, Destino, Cantidad, Fecha, Comprador, Campesinos -->
        <div class="row g-3 justify-content-center text-center">
            
            <!-- 1. Lugar de Origen -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-4 h-100 border shadow-none">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">
                        <i class="bi bi-geo-alt me-1 text-success"></i> Lugar de Origen
                    </small>
                    <span class="fw-bold text-dark fs-6">@Model.LugarOrigen</span>
                </div>
            </div>

            <!-- 2. Lugar de Destino -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-4 h-100 border shadow-none">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">
                        <i class="bi bi-geo-alt-fill me-1 text-success"></i> Lugar de Destino
                    </small>
                    <span class="fw-bold text-dark fs-6">@Model.LugarDestino</span>
                </div>
            </div>

            <!-- 3. Cantidad de Producto -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-4 h-100 border border-success shadow-none">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">
                        <i class="bi bi-box-seam me-1 text-success"></i> Cantidad a Transportar
                    </small>
                    <span class="fw-bold text-success fs-5">@Model.CantidadKg.ToString("N0") Kilos</span>
                </div>
            </div>

            <!-- 4. Fecha de Entrega -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-4 h-100 border shadow-none">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">
                        <i class="bi bi-calendar-event me-1 text-danger"></i> Fecha de Entrega
                    </small>
                    <span class="fw-bold text-danger fs-6">@Model.FechaEntrega.ToString("dd/MM/yyyy")</span>
                </div>
            </div>

            <!-- 5. Comprador -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-4 h-100 border shadow-none">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">
                        <i class="bi bi-person me-1 text-primary"></i> Comprador
                    </small>
                    <span class="fw-bold text-dark fs-6">@Model.NombreComprador</span>
                    <small class="d-block text-muted">Tel: @Model.TelefonoComprador</small>
                </div>
            </div>

            <!-- 6. Campesinos Participantes -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-4 h-100 border shadow-none">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">
                        <i class="bi bi-people me-1 text-success"></i> Campesinos Participantes
                    </small>
                    @if (Model.CampesinosParticipantes != null && Model.CampesinosParticipantes.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 justify-content-center mt-1">
                            @foreach (var camp in Model.CampesinosParticipantes)
                            {
                                <span class="badge bg-success-subtle text-success border border-success rounded-pill px-2 py-1 small">
                                    @camp.NombreCampesino (@camp.KilosAportados Kg)
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">Cosecha acopiada por campesinos locales</span>
                    }
                </div>
            </div>

        </div>
    </div>

    <!-- ============================================================== -->
    <!-- TABLA SELECCIONABLE DE CONDUCTORES DISPONIBLES                 -->
    <!-- ============================================================== -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h4 class="fw-bold text-dark mb-0">Conductores y Vehículos Disponibles</h4>
                <p class="text-muted small mb-0">
                    Solo se listan camiones con capacidad igual o superior a @Model.CantidadKg.ToString("N0") Kg y documentos vigentes.
                </p>
            </div>
            <span class="badge bg-secondary rounded-pill px-3 py-2">@Model.CamionesDisponibles.Count disponibles</span>
        </div>

        @if (Model.CamionesDisponibles != null && Model.CamionesDisponibles.Any())
        {
            <form id="formAsignacion" method="post" asp-action="Asignar">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idDemanda" value="@Model.IdDemanda" />
                <input type="hidden" id="idCamionSeleccionadoInput" name="idCamion" value="" />

                <div class="table-responsive mb-4 rounded-4 border overflow-hidden">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th scope="col" class="text-center py-3" style="width: 70px;">Elegir</th>
                                <th scope="col" class="py-3">Conductor</th>
                                <th scope="col" class="text-center py-3">Teléfono</th>
                                <th scope="col" class="text-center py-3">Placa</th>
                                <th scope="col" class="py-3">Modelo / Tipo</th>
                                <th scope="col" class="text-center py-3">Capacidad</th>
                                <th scope="col" class="text-center py-3">Documentos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var camion in Model.CamionesDisponibles)
                            {
                                <tr style="cursor: pointer;" onclick="document.getElementById('radio_@camion.IdCamion').checked = true; actualizarSeleccion(@camion.IdCamion, '@camion.NombreConductor');">
                                    <!-- Radio button para seleccionar el camión -->
                                    <td class="text-center">
                                        <input class="form-check-input fs-5 radio-camion" 
                                               type="radio" 
                                               name="radioCamion" 
                                               id="radio_@camion.IdCamion" 
                                               value="@camion.IdCamion"
                                               data-nombre="@camion.NombreConductor"
                                               onchange="actualizarSeleccion(@camion.IdCamion, '@camion.NombreConductor');" />
                                    </td>

                                    <!-- Conductor -->
                                    <td>
                                        <span class="fw-bold text-dark">@camion.NombreConductor</span>
                                    </td>

                                    <!-- Teléfono -->
                                    <td class="text-center text-muted">
                                        @camion.TelefonoConductor
                                    </td>

                                    <!-- Placa -->
                                    <td class="text-center">
                                        <span class="badge bg-warning text-dark border rounded-pill px-3 py-2 fw-bold fs-6">
                                            @camion.Placa
                                        </span>
                                    </td>

                                    <!-- Modelo -->
                                    <td>
                                        <span class="fw-semibold text-secondary">@camion.Modelo</span>
                                    </td>

                                    <!-- Capacidad -->
                                    <td class="text-center">
                                        <span class="badge bg-light text-success border border-success rounded-pill px-3 py-2 fw-bold">
                                            @camion.CapacidadKg.ToString("N0") Kg
                                        </span>
                                    </td>

                                    <!-- Documentos vigentes -->
                                    <td class="text-center">
                                        <span class="badge bg-success rounded-pill px-3 py-2 small" title="Pase, SOAT y Tecnomecánica Vigentes">
                                            <i class="bi bi-check-circle-fill me-1"></i> Vigentes
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Botones inferiores de acción con bordes redondeados -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Regresar
                    </a>

                    <!-- Botón verde Asignar: Activa la modal de confirmación -->
                    <button type="button" 
                            id="btnAbrirModalAsignar" 
                            class="btn btn-success rounded-pill px-5 py-2 fw-bold text-white shadow-sm"
                            style="background-color: #2e7d32; border-color: #2e7d32;"
                            onclick="abrirModalConfirmacion();">
                        <i class="bi bi-truck me-1"></i> Asignar
                    </button>
                </div>

            </form>
        }
        else
        {
            <!-- Caso cuando ningún camión cumple capacidad o papeles -->
            <div class="alert alert-warning text-center py-4 rounded-4 my-3 shadow-sm border-0">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-1 d-block mb-2"></i>
                <h5 class="fw-bold text-dark">No hay vehículos idóneos disponibles en este momento</h5>
                <p class="text-muted mb-3">
                    No se encontraron camiones registrados con capacidad mínima de <strong>@Model.CantidadKg.ToString("N0") Kg</strong> y con todos sus documentos al día.
                </p>
                <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Cargas Pendientes
                </a>
            </div>
        }

    </div>

</div>

<!-- ============================================================== -->
<!-- MODAL DE CONFIRMACIÓN (PASO 6 DEL CU-020)                      -->
<!-- ============================================================== -->
<div class="modal fade" id="modalConfirmarAsignacion" tabindex="-1" aria-labelledby="modalConfirmarAsignacionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
            
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold" id="modalConfirmarAsignacionLabel">
                    <i class="bi bi-truck me-2"></i>Confirmar Asignación de Transporte
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <i class="bi bi-question-circle text-success fs-1"></i>
                </div>
                <!-- Mensaje de confirmación -->
                <h5 class="fw-bold text-dark mb-2">
                    ¿Está seguro de asignar este pedido al conductor <span id="nombreConductorEnModal" class="text-success"></span>?
                </h5>
                <p class="text-muted small mb-0">
                    Se asociará el camión a la orden de transporte y se registrará la asignación en el sistema.
                </p>
            </div>

            <!-- Botones Confirmar y Cancelar con estilo rounded-pill -->
            <div class="modal-footer bg-light border-0 py-3 justify-content-center gap-2">
                <!-- Botón Cancelar -->
                <button type="button" class="btn btn-secondary rounded-pill px-4 fw-semibold shadow-sm" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <!-- Botón Confirmar (Envía el formulario POST) -->
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold text-white shadow-sm" style="background-color: #2e7d32; border-color: #2e7d32;" onclick="confirmarEnvioFormulario();">
                    Confirmar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Scripts de control para la selección e interactividad de la modal -->
<script>
    var conductorSeleccionadoActual = "";
    var idCamionSeleccionadoActual = 0;

    function actualizarSeleccion(idCamion, nombreConductor) {
        idCamionSeleccionadoActual = idCamion;
        conductorSeleccionadoActual = nombreConductor;
        document.getElementById('idCamionSeleccionadoInput').value = idCamion;
    }

    function abrirModalConfirmacion() {
        if (!idCamionSeleccionadoActual || idCamionSeleccionadoActual <= 0) {
            alert("Por favor seleccione un conductor y camión de la tabla antes de hacer clic en Asignar.");
            return;
        }

        document.getElementById('nombreConductorEnModal').textContent = conductorSeleccionadoActual;

        var modalEl = document.getElementById('modalConfirmarAsignacion');
        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        modal.show();
    }

    function confirmarEnvioFormulario() {
        var form = document.getElementById('formAsignacion');
        if (form) {
            form.submit();
        }
    }
</script>

