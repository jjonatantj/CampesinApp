@model CampesinApp.ViewModels.DetalleAsignacionViewModel

@{
    ViewData["Title"] = $"Detalle Pedido #{Model.IdDemanda} - Asignación de Camión";
    Layout = "_LayoutCasosUso";
}

<div class="container main-container py-4 my-4">

    <!-- ============================================================== -->
    <!-- PARTE SUPERIOR IZQUIERDA: BOTÓN "REGRESAR" GRIS (FA02-CU020)   -->
    <!-- ============================================================== -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <!-- Botón Regresar (Flujo alterno FA02-CU020) -->
            <a asp-action="Index" class="btn btn-secondary px-4 fw-semibold shadow-sm">
                ← Regresar
            </a>
        </div>
        <div class="text-end">
            <span class="badge bg-success px-3 py-2 fs-6 rounded-pill">
                Asignación de Vehículo (CU-020)
            </span>
        </div>
    </div>

    <!-- Alertas de excepción (FE01-CU020: camión sin espacio o no disponible) -->
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">⚠️</span>
                <div>
                    <strong>Aviso:</strong> @TempData["MensajeError"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- ============================================================== -->
    <!-- PASO 4: INFORMACIÓN DEL PEDIDO EN LA PARTE SUPERIOR Y CENTRADA -->
    <!-- ============================================================== -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4 mb-4">
        <div class="text-center mb-4">
            <span class="badge bg-primary px-3 py-2 fs-6 mb-2">Pedido #@Model.IdDemanda</span>
            <h2 class="brand-title mb-1 text-center">@Model.NombreProducto (@Model.Variedad)</h2>
            <p class="text-muted fw-semibold mb-0">Detalles de logística y cosecha esperando transporte</p>
        </div>

        <!-- Fila de métricas centradas: Origen, Destino, Cantidad, Fecha, Campesinos, Comprador -->
        <div class="row g-3 justify-content-center text-center">
            
            <!-- 1. Lugar de Origen -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100 border">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">📍 Lugar de Origen</small>
                    <span class="fw-bold text-dark fs-6">@Model.LugarOrigen</span>
                </div>
            </div>

            <!-- 2. Lugar de Destino -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100 border">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">🏁 Lugar de Destino</small>
                    <span class="fw-bold text-dark fs-6">@Model.LugarDestino</span>
                </div>
            </div>

            <!-- 3. Cantidad de Producto -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100 border border-success">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">⚖️ Cantidad a Transportar</small>
                    <span class="fw-bold text-success fs-5">@Model.CantidadKg.ToString("N0") Kilos</span>
                </div>
            </div>

            <!-- 4. Fecha de Entrega -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100 border">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">📅 Fecha de Entrega</small>
                    <span class="fw-bold text-danger fs-6">@Model.FechaEntrega.ToString("dd/MM/yyyy")</span>
                </div>
            </div>

            <!-- 5. Comprador -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100 border">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">👤 Comprador</small>
                    <span class="fw-bold text-dark fs-6">@Model.NombreComprador</span>
                    <small class="d-block text-muted">Tel: @Model.TelefonoComprador</small>
                </div>
            </div>

            <!-- 6. Campesinos Participantes -->
            <div class="col-md-4 col-sm-6">
                <div class="p-3 bg-light rounded-3 h-100 border">
                    <small class="text-muted fw-bold text-uppercase d-block mb-1">🌾 Campesinos Participantes</small>
                    @if (Model.CampesinosParticipantes != null && Model.CampesinosParticipantes.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 justify-content-center mt-1">
                            @foreach (var camp in Model.CampesinosParticipantes)
                            {
                                <span class="badge bg-success-subtle text-success border border-success px-2 py-1 small">
                                    @camp.NombreCampesino (@camp.KilosAportados Kg)
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">Cosecha acopiada por campesinos locales</span>
                    }
                </div>
            </div>

        </div>
    </div>

    <!-- ============================================================== -->
    <!-- PASO 4 (CONT.): TABLA SELECCIONABLE DE CONDUCTORES DISPONIBLES -->
    <!-- ============================================================== -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-0">Conductores y Vehículos Disponibles</h4>
                <p class="text-muted small mb-0">
                    Solo se listan camiones con capacidad igual o superior a @Model.CantidadKg.ToString("N0") Kg y documentos vigentes (RN-01 y RN-02).
                </p>
            </div>
            <span class="badge bg-secondary">@Model.CamionesDisponibles.Count disponibles</span>
        </div>

        @if (Model.CamionesDisponibles != null && Model.CamionesDisponibles.Any())
        {
            <form id="formAsignacion" method="post" asp-action="Asignar">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idDemanda" value="@Model.IdDemanda" />
                <input type="hidden" id="idCamionSeleccionadoInput" name="idCamion" value="" />

                <div class="table-responsive mb-4">
                    <table class="table table-hover align-middle mb-0 border">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center" style="width: 70px;">Elegir</th>
                                <th scope="col">Conductor</th>
                                <th scope="col" class="text-center">Teléfono</th>
                                <th scope="col" class="text-center">Placa</th>
                                <th scope="col">Modelo / Tipo</th>
                                <th scope="col" class="text-center">Capacidad</th>
                                <th scope="col" class="text-center">Papeles al Día (RN-02)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var camion in Model.CamionesDisponibles)
                            {
                                <tr style="cursor: pointer;" onclick="document.getElementById('radio_@camion.IdCamion').checked = true; actualizarSeleccion(@camion.IdCamion, '@camion.NombreConductor');">
                                    <!-- Radio button para seleccionar el camión -->
                                    <td class="text-center">
                                        <input class="form-check-input fs-5 radio-camion" 
                                               type="radio" 
                                               name="radioCamion" 
                                               id="radio_@camion.IdCamion" 
                                               value="@camion.IdCamion"
                                               data-nombre="@camion.NombreConductor"
                                               onchange="actualizarSeleccion(@camion.IdCamion, '@camion.NombreConductor');" />
                                    </td>

                                    <!-- Conductor -->
                                    <td>
                                        <span class="fw-bold text-dark">@camion.NombreConductor</span>
                                    </td>

                                    <!-- Teléfono -->
                                    <td class="text-center text-muted">
                                        @camion.TelefonoConductor
                                    </td>

                                    <!-- Placa -->
                                    <td class="text-center">
                                        <span class="badge bg-warning text-dark border px-3 py-2 fw-bold fs-6">
                                            @camion.Placa
                                        </span>
                                    </td>

                                    <!-- Modelo -->
                                    <td>
                                        <span class="fw-semibold text-secondary">@camion.Modelo</span>
                                    </td>

                                    <!-- Capacidad -->
                                    <td class="text-center">
                                        <span class="badge bg-light text-success border border-success px-3 py-2 fw-bold">
                                            @camion.CapacidadKg.ToString("N0") Kg
                                        </span>
                                    </td>

                                    <!-- Documentos al día (RN-02-CU020) -->
                                    <td class="text-center">
                                        <span class="badge bg-success px-2 py-1 small" title="Pase, SOAT y Tecnomecánica Vigentes">
                                            ✓ Documentos Vigentes
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Botones inferiores de acción (Paso 4 y 5) -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">
                        ← Regresar
                    </a>

                    <!-- Botón verde Asignar: Activa la modal de confirmación del Paso 6 -->
                    <button type="button" 
                            id="btnAbrirModalAsignar" 
                            class="btn btn-success btn-lg px-5 fw-bold shadow-sm"
                            onclick="abrirModalConfirmacion();">
                        🚛 Asignar Vehículo
                    </button>
                </div>

            </form>
        }
        else
        {
            <!-- Caso cuando ningún camión cumple capacidad o papeles -->
            <div class="alert alert-warning text-center py-4 rounded-3 my-3">
                <span class="fs-1 d-block mb-2">⚠️</span>
                <h5 class="fw-bold text-dark">No hay vehículos idóneos disponibles en este momento</h5>
                <p class="text-muted mb-3">
                    No se encontraron camiones registrados con capacidad mínima de <strong>@Model.CantidadKg.ToString("N0") Kg</strong> y con todos sus documentos al día (RN-01 y RN-02).
                </p>
                <a asp-action="Index" class="btn btn-secondary px-4">
                    ← Volver a Cargas Pendientes
                </a>
            </div>
        }

    </div>

</div>

<!-- ============================================================== -->
<!-- MODAL DE CONFIRMACIÓN (PASO 6 DEL CU-020)                      -->
<!-- ============================================================== -->
<div class="modal fade" id="modalConfirmarAsignacion" tabindex="-1" aria-labelledby="modalConfirmarAsignacionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0 rounded-3">
            
            <div class="modal-header bg-success text-white rounded-top-3">
                <h5 class="modal-title fw-bold" id="modalConfirmarAsignacionLabel">
                    🚛 Confirmar Asignación de Transporte
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body p-4 text-center">
                <div class="mb-3">
                    <span class="fs-1 text-success">❓</span>
                </div>
                <!-- Mensaje exacto de la especificación (Paso 6): "¿Está seguro de asignar este pedido al conductor [Nombre]?" -->
                <h5 class="fw-bold text-dark mb-2">
                    ¿Está seguro de asignar este pedido al conductor <span id="nombreConductorEnModal" class="text-success"></span>?
                </h5>
                <p class="text-muted small mb-0">
                    Se asociará el camión a la orden de transporte y se registrará la asignación en la base de datos.
                </p>
            </div>

            <!-- Botones Confirmar y Cancelar (FA03-CU020: Cancelación) -->
            <div class="modal-footer bg-light rounded-bottom-3 justify-content-center gap-2">
                <!-- Botón Cancelar (FA03-CU020) -->
                <button type="button" class="btn btn-secondary px-4 fw-semibold" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <!-- Botón Confirmar (Paso 7: Envía el formulario POST) -->
                <button type="button" class="btn btn-success px-4 fw-bold shadow-sm" onclick="confirmarEnvioFormulario();">
                    ✓ Confirmar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Scripts de control para la selección e interactividad de la modal -->
<script>
    var conductorSeleccionadoActual = "";
    var idCamionSeleccionadoActual = 0;

    function actualizarSeleccion(idCamion, nombreConductor) {
        idCamionSeleccionadoActual = idCamion;
        conductorSeleccionadoActual = nombreConductor;
        document.getElementById('idCamionSeleccionadoInput').value = idCamion;
    }

    function abrirModalConfirmacion() {
        if (!idCamionSeleccionadoActual || idCamionSeleccionadoActual <= 0) {
            alert("Por favor seleccione un conductor y camión de la tabla antes de hacer clic en Asignar.");
            return;
        }

        // Asignamos el nombre en el cuerpo del modal (Paso 6)
        document.getElementById('nombreConductorEnModal').textContent = conductorSeleccionadoActual;

        // Abrir modal de Bootstrap 5 de manera segura
        var modalEl = document.getElementById('modalConfirmarAsignacion');
        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        modal.show();
    }

    function confirmarEnvioFormulario() {
        // Enviar formulario (Paso 7)
        var form = document.getElementById('formAsignacion');
        if (form) {
            form.submit();
        }
    }
</script>

