@model ReporteVistaDto
<div class="modal-body p-4">
    <div class="cuadro-notificacion p-3">
        <h5 class="fw-bold">Nueva actualización de ubicación recibida</h5>
        <dl class="row mb-0">
            <dt class="col-5">Pedido</dt>
            <dd class="col-7">@Model.CodigoPedido</dd>
            <dt class="col-5">Lugar / Punto de acopio</dt>
            <dd class="col-7">@Model.Lugar</dd>
            <dt class="col-5">Tipo de reporte</dt>
            <dd class="col-7">@Model.Hito</dd>
            <dt class="col-5">Fecha actual</dt>
            <dd class="col-7">@Formato.Fecha(Model.FechaHora)</dd>
            <dt class="col-5">Hora</dt>
            <dd class="col-7">@Formato.Hora(Model.FechaHora)</dd>
            <dt class="col-5">Coordenadas</dt>
            <dd class="col-7 mb-0">@VistaHelpers.Coordenadas(Model.Latitud, Model.Longitud)</dd>
        </dl>
    </div>
    <div class="mt-3">
        <h6 class="fw-bold">Ubicación del transportador en el mapa</h6>
        <div data-mapa="ver" data-puntos="@VistaHelpers.PuntosJson(Model.Destino == null ? Model.Recorrido : Model.Recorrido.Append(Model.Destino))" class="mapa-contenedor" aria-label="Mapa con la ubicación del transportador"></div>
        <p class="small text-muted mt-1 mb-0">El marcador rojo es la última ubicación reportada, la línea verde es el recorrido y el cuadro azul es el punto de acopio de entrega.</p>
    </div>
</div>
<div class="modal-footer justify-content-between">
    @if (Model.Guardado)
    {
        <span class="text-success small">Este reporte ya está guardado en su panel.</span>
    }
    else
    {
        <button type="button" class="btn btn-outline-dark" data-modal-post="/Ubicacion/GuardarAlerta?idReporte=@Model.IdReporteUbicacion">Guardar reporte</button>
    }
    <button type="button" class="btn btn-dark" data-modal-cerrar="superpuesta">Cerrar</button>
</div>
